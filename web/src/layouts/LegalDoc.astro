---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    rawMdHref?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="screen-only">
    <Nav />
  </div>

  <main class="container mx-auto max-w-3xl px-6 py-12 md:px-10 md:py-16">
    <div class="screen-only mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-ink/10 pb-6">
      <a href="/legal" class="text-sm text-stone hover:text-ink">← Back to legal documents</a>
      <div class="flex gap-3">
        {frontmatter.rawMdHref && (
          <a href={frontmatter.rawMdHref} class="text-sm rounded-sm border border-ink/20 px-4 py-2 hover:border-ink" download>
            Download .md
          </a>
        )}
        <button onclick="window.print()" class="text-sm rounded-sm bg-ink px-4 py-2 text-paper hover:bg-signal">
          Print / Save as PDF
        </button>
      </div>
    </div>

    <article class="legal-doc">
      <slot />
    </article>
  </main>

  <div class="screen-only">
    <Footer />
  </div>
</Base>

<style is:global>
  .legal-doc h1 {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
    font-size: 2.25rem;
    line-height: 1.15;
    margin: 0 0 1.5rem;
  }
  .legal-doc h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.2;
    margin: 2rem 0 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid #e3ddd0;
  }
  .legal-doc h3 {
    font-weight: 600;
    font-size: 1.1rem;
    margin: 1.5rem 0 0.5rem;
  }
  .legal-doc p {
    margin: 0.75rem 0;
    line-height: 1.6;
    color: #1a1f24;
  }
  .legal-doc ul, .legal-doc ol {
    padding-left: 1.5rem;
    margin: 0.75rem 0;
  }
  .legal-doc li {
    margin: 0.35rem 0;
    line-height: 1.55;
  }
  .legal-doc strong { font-weight: 600; }
  .legal-doc em { font-style: italic; }
  .legal-doc hr {
    border: none;
    border-top: 1px solid #c9462c;
    margin: 1.5rem 0;
  }
  .legal-doc blockquote {
    border-left: 3px solid #c9462c;
    margin: 1rem 0;
    padding: 0.5rem 1rem;
    background: #fef3ef;
    color: #1a1f24;
    font-size: 0.95rem;
  }
  .legal-doc table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.95rem;
  }
  .legal-doc th, .legal-doc td {
    border: 1px solid #e3ddd0;
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .legal-doc th { background: #f7f1e2; font-weight: 600; }
  .legal-doc code {
    font-family: 'SF Mono', Menlo, Consolas, monospace;
    background: #f7f1e2;
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
    font-size: 0.9em;
  }

  @media print {
    .screen-only { display: none !important; }
    body { background: #fff !important; color: #000 !important; }
    .legal-doc { max-width: none !important; }
    .legal-doc h1 { font-size: 22pt; }
    .legal-doc h2 { font-size: 14pt; border-top-color: #888; page-break-after: avoid; }
    .legal-doc h3 { font-size: 12pt; page-break-after: avoid; }
    .legal-doc p, .legal-doc li { font-size: 11pt; }
    .legal-doc table { font-size: 10pt; page-break-inside: avoid; }
    .legal-doc blockquote { background: #f5f5f5; }
    @page { margin: 0.75in; }
  }
</style>
