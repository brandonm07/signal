---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const tools = [
  {
    slug: 'carrier-renewal-checklist',
    title: 'Carrier Renewal Checklist',
    summary: 'Twenty-one items to confirm before you sign the next renewal. Term, escalators, exit rights, redundancy, service credits, billing. Use it as a meeting agenda with the account team.',
    status: 'available',
  },
  {
    slug: 'invoice-fee-decoder',
    title: 'Invoice Fee Decoder',
    summary: 'Plain-English translations for every line item on a typical business carrier invoice. Regulatory Recovery Fee, Cost Assessment Charge, Property Tax Allotment — what they are, which are real, which are negotiable.',
    status: 'coming-soon',
  },
  {
    slug: 'vendor-consolidation-scorecard',
    title: 'Vendor Consolidation Scorecard',
    summary: 'A scoring framework for deciding which vendors to keep, which to consolidate, and which to walk away from. Risk, redundancy, switching cost, and contract leverage on one page.',
    status: 'coming-soon',
  },
  {
    slug: 'sdwan-vs-mpls-worksheet',
    title: 'SD-WAN vs MPLS Decision Worksheet',
    summary: 'Side-by-side comparison built around the questions multi-site companies actually need to answer: bandwidth, reliability, failover, security, total cost over a three-year horizon.',
    status: 'coming-soon',
  },
  {
    slug: 'technology-spend-inventory',
    title: 'Technology Spend Inventory Template',
    summary: 'The single-page inventory we build at the start of every engagement. Every provider, every monthly cost, every renewal date, every account contact. Fill in your own and the consolidation decisions get straightforward.',
    status: 'coming-soon',
  },
];
---

<Base
  title="Tools — Signal Advisory LLC · Free downloads for buyers of business technology"
  description="Free downloadable tools for negotiating carrier renewals, decoding invoices, consolidating vendors, and inventorying technology spend."
>
  <Nav />

  <section class="container mx-auto max-w-5xl px-6 pb-12 pt-20 md:px-10 md:pt-28">
    <p class="mb-5 text-xs uppercase tracking-[0.2em] text-stone">Tools</p>
    <h1 class="display text-4xl font-light leading-[1.05] md:text-6xl">
      The same frameworks<br />
      <em class="text-signal not-italic font-medium">we use on every engagement.</em>
    </h1>
    <p class="mt-10 max-w-2xl text-lg leading-relaxed text-ink/80">
      Free downloadable tools for businesses that want to do some of this work themselves
      before deciding whether to bring us in. Use them, share them, mark them up.
    </p>
  </section>

  <section class="border-t border-ink/10 py-16">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <div class="grid gap-8 md:grid-cols-2">
        {
          tools.map((t) => (
            <div class="border border-ink/10 p-8 flex flex-col">
              <div class="flex items-start justify-between mb-3 gap-3">
                <h2 class="display text-xl font-medium leading-snug">{t.title}</h2>
                {t.status === 'coming-soon' && (
                  <span class="flex-none text-[10px] uppercase tracking-wider bg-paper border border-ink/15 text-stone px-2 py-1 rounded-sm">Coming soon</span>
                )}
              </div>
              <p class="text-ink/70 leading-relaxed text-[15px] mb-6 flex-1">{t.summary}</p>
              {t.status === 'available' ? (
                <a
                  href={`/tools/${t.slug}`}
                  class="self-start inline-block rounded-sm bg-signal px-6 py-3 text-sm font-semibold text-paper hover:bg-ink transition-colors"
                >
                  Open the tool →
                </a>
              ) : (
                <a
                  href="mailto:brandon@signaladvise.com?subject=Notify%20me%20when%20the%20tool%20is%20ready"
                  class="self-start inline-block rounded-sm border border-ink/30 px-6 py-3 text-sm font-semibold text-ink hover:bg-ink hover:text-paper transition-colors"
                >
                  Notify me when ready
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-ink/10 bg-ink py-20 text-paper">
    <div class="container mx-auto max-w-3xl px-6 text-center md:px-10">
      <h2 class="display mb-6 text-3xl font-normal leading-tight md:text-4xl">
        Want us to apply one of these to your invoice or renewal?
      </h2>
      <p class="mb-10 text-lg text-paper/70 leading-relaxed">
        Send us the document. We'll mark up the opportunity.
      </p>
      <a
        href="/audit"
        class="inline-block rounded-sm bg-signal px-8 py-4 text-sm font-semibold text-paper hover:bg-paper hover:text-ink transition-colors"
      >
        Send one invoice →
      </a>
    </div>
  </section>

  <Footer />
</Base>
