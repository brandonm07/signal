---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
// HOLD UNTIL CERTIFIED: WBE / supplier-diversity line in "Procurement ready".
// Do not publish until certification is issued.
---

<Base
  title="Bill, contract, and renewal management for large organizations | Signal Advisory"
  description="For organizations with 1,000+ employees or 50+ locations: every telecom bill, contract, and renewal managed in one place, billing errors recovered, competitive bids across 200+ providers, and reporting finance can use."
>
  <Nav />

  <section class="container mx-auto max-w-4xl px-6 pb-12 pt-24 md:px-10 md:pt-32">
    <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">Large organizations · 1,000+ employees or 50+ locations</p>
    <h1 class="display text-3xl font-light leading-[1.15] md:text-5xl">
      Every bill, contract, and renewal across every location.
      <em class="text-signal not-italic font-medium">Managed in one place.</em>
    </h1>
  </section>

  <section class="container mx-auto max-w-3xl px-6 pb-8 md:px-10">
    <div class="space-y-10">
      <div class="border-t border-ink/10 pt-8">
        <h2 class="display text-2xl font-medium mb-3">The model</h2>
        <p class="text-ink/75 leading-relaxed">
          We keep a complete inventory of what you pay for and where, check every bill against its contract every month, dispute billing errors and recover the credits, and cancel what you no longer use. When a big decision comes up, like upgrading the network between your locations, replacing old copper phone lines, or consolidating your company phones, we run a competitive bid across 200+ providers and oversee the switch.
        </p>
      </div>
      <div class="border-t border-ink/10 pt-8">
        <h2 class="display text-2xl font-medium mb-3">Pricing</h2>
        <p class="text-ink/75 leading-relaxed">
          Every engagement is priced to its scope and proposed up front, with a structure that ties our results to yours. Contact us for a scoped proposal.
        </p>
      </div>
      <div class="border-t border-ink/10 pt-8">
        <h2 class="display text-2xl font-medium mb-3">Procurement ready</h2>
        <p class="text-ink/75 leading-relaxed">
          NDA, MSA, W-9, and certificate of insurance available on request. Documented data handling practices, detailed on our
          <a href="/security" class="underline hover:text-ink">security page</a>.
        </p>
      </div>
      <div class="border-t border-ink/10 pt-8">
        <h2 class="display text-2xl font-medium mb-3">Where we're strongest</h2>
        <p class="text-ink/75 leading-relaxed">
          Multi-site distributed enterprises: manufacturing, retail and entertainment, insurance, food and consumer products. If you have 50 locations and 50 invoices, you are exactly who this was built for.
        </p>
      </div>
    </div>

    <div class="mt-14 flex flex-wrap gap-4 border-t border-ink/10 pt-10">
      <a href="https://calendly.com/signaladvise-info/30min" target="_blank" rel="noopener" class="inline-block rounded-sm bg-signal px-8 py-4 text-sm font-semibold text-paper hover:bg-ink transition-colors">
        Schedule a 30-minute scoping call
      </a>
      <a href="mailto:info@signaladvise.com?subject=Enterprise%20proposal%20request" class="inline-block rounded-sm border border-ink/30 px-8 py-4 text-sm font-semibold text-ink hover:bg-ink hover:text-paper transition-colors">
        Request an enterprise proposal →
      </a>
    </div>
  </section>

  <Footer />
</Base>
