---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const docs = [
  {
    title: 'Master Services Agreement (MSA)',
    href: '/legal/msa',
    rawHref: '/legal/signal-advisory-msa-template.md',
    summary: 'Template engagement agreement covering scope, fees, confidentiality, IP, liability cap, indemnification, and Missouri governing law. Signed once per client, references one or more SOWs.',
  },
  {
    title: 'Letter of Authorization (LOA)',
    href: '/legal/loa',
    rawHref: '/legal/signal-advisory-loa-template.md',
    summary: 'Authorization for Signal Advisory to act on a client\'s behalf with their carriers and vendors — account inquiries, MAC orders, billing disputes, contract negotiation support. Scoped, time-limited, no contractual binding authority.',
  },
];
---

<Base
  title="Legal documents — Signal Advisory"
  description="Master Services Agreement and Letter of Authorization templates for Signal Advisory client engagements."
>
  <Nav />

  <section class="container mx-auto max-w-3xl px-6 py-20 md:px-10 md:py-28">
    <p class="mb-5 text-xs uppercase tracking-[0.2em] text-stone">Legal</p>
    <h1 class="display text-4xl font-light leading-[1.05] md:text-5xl">Engagement documents</h1>
    <p class="mt-8 text-lg leading-relaxed text-ink/75">
      Standard engagement paperwork. Review the templates below, print to PDF, or download the raw markdown for editing.
    </p>

    <div class="mt-12 divide-y divide-ink/10">
      {docs.map((d) => (
        <div class="py-8">
          <h2 class="display text-2xl font-medium">{d.title}</h2>
          <p class="mt-3 text-ink/70 leading-relaxed">{d.summary}</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href={d.href} class="text-sm rounded-sm bg-ink px-5 py-2.5 text-paper hover:bg-signal">View / Print</a>
            <a href={d.rawHref} download class="text-sm rounded-sm border border-ink/20 px-5 py-2.5 hover:border-ink">Download .md</a>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-12 text-sm text-stone italic">
      Templates only. Final versions for any specific engagement are reviewed and finalized by counsel. Not legal advice.
    </p>
  </section>

  <Footer />
</Base>
