---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Small business telecom and IT cost management | Signal Advisory"
  description="Telecom and IT cost management for small business. Send one invoice, get a free 24-hour markup of every junk fee and unused service. Carrier neutral, disclosed compensation."
>
  <Nav />

  <section class="container mx-auto max-w-4xl px-6 pb-12 pt-24 md:px-10 md:pt-32">
    <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">Small business · under 50 employees</p>
    <h1 class="display text-3xl font-light leading-[1.15] md:text-5xl">
      You're paying enterprise prices without
      <em class="text-signal not-italic font-medium">enterprise leverage. We fix that.</em>
    </h1>
  </section>

  <section class="container mx-auto max-w-3xl px-6 pb-8 md:px-10">
    <div class="space-y-10">
      <div class="border-t border-ink/10 pt-8">
        <h2 class="display text-2xl font-medium mb-3">The problem</h2>
        <p class="text-ink/75 leading-relaxed">
          Carriers price small businesses at the rack rate because nobody pushes back. The average small business invoice we review contains fees that were never in the contract, services nobody uses, and a renewal date nobody wrote down.
        </p>
      </div>
      <div class="border-t border-ink/10 pt-8">
        <h2 class="display text-2xl font-medium mb-3">What we do</h2>
        <p class="text-ink/75 leading-relaxed">
          Send us one invoice. Within 24 hours we mark up everything we would challenge. If we find savings, you choose: take the markup and handle it yourself, or have us negotiate it and manage the account going forward.
        </p>
      </div>
      <div class="border-t border-ink/10 pt-8">
        <h2 class="display text-2xl font-medium mb-3">What it costs</h2>
        <p class="text-ink/75 leading-relaxed">
          The first review is free. Ongoing management is a low flat monthly fee, scoped to your size. In most engagements the supplier pays us a commission on services we place, which we
          <a href="/how-we-get-paid" class="underline hover:text-ink">disclose in writing</a>, so our management fee stays small.
        </p>
      </div>
    </div>

    <div class="mt-14 border-t border-ink/10 pt-10">
      <a href="/audit" class="inline-block rounded-sm bg-signal px-8 py-4 text-sm font-semibold text-paper hover:bg-ink transition-colors">
        Send us one invoice →
      </a>
    </div>
  </section>

  <Footer />
</Base>
