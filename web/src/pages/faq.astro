---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    q: 'Do I have to switch providers?',
    a: 'No. Most of the time you stay with the exact providers you have now, at a better rate and better terms. The leverage is in being willing to switch, not in actually switching.',
  },
  {
    q: 'I am locked into a contract. Is it too late?',
    a: 'Under contract is the best time to start. We find the fees and services you are being charged for that were never in the contract, and we get ahead of the renewal so the next one is on your terms instead of the carrier\'s.',
  },
  {
    q: 'My IT person already handles our phones and internet.',
    a: 'Your IT person keeps things running, which is a full-time job. Fighting the bill is a different job, and it is the one the carrier is betting nobody at your company has time for. We work alongside IT, not around them.',
  },
  {
    q: 'Is this a sales pitch for a carrier?',
    a: 'No. We are independent. We do not work for any carrier and we never sell you one. We work for you, and our only job is to make your bills smaller.',
  },
  {
    q: 'How is this free? What is the catch?',
    a: 'The review is free, every time, with no obligation. If you want us to negotiate, it is no savings, no fee: if we cannot lower your bill, you owe nothing. There is no catch, because we only get paid when you save.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

---

<Base
  title="Questions | Signal Advisory"
  description="How Signal Advisory works: no switching providers, no savings no fee, independent of every carrier. Answers to the questions business owners ask before sending a bill."
  jsonLd={faqSchema}
>
  <Nav />

  <section class="container mx-auto max-w-3xl px-6 pb-12 pt-24 md:px-10 md:pt-32">
    <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">Common questions</p>
    <h1 class="display text-3xl font-light leading-[1.15] md:text-5xl">
      The things owners ask
      <em class="text-signal not-italic font-medium">before they send a bill.</em>
    </h1>
  </section>

  <section class="container mx-auto max-w-3xl px-6 pb-16 md:px-10">
    <div class="divide-y divide-ink/10 border-t border-ink/10">
      {faqs.map((f) => (
        <div class="py-7">
          <h2 class="display text-lg font-medium mb-2">{f.q}</h2>
          <p class="text-ink/75 leading-relaxed">{f.a}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="cost" class="border-t border-ink/10 bg-ink/[0.03] py-20">
    <div class="container mx-auto max-w-3xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">What it costs</p>
      <h2 class="display mb-6 text-3xl font-normal leading-tight md:text-4xl">
        The review is free. Negotiation is no savings, no fee.
      </h2>
      <p class="text-ink/75 leading-relaxed mb-4">
        If we cannot lower your bill, you owe nothing. That is the whole deal.
      </p>
      <p class="text-ink/75 leading-relaxed">
        Want us to keep watching your bills every month so the savings do not creep back?
        That is a simple monthly plan, quoted up front, with no long-term contract.
      </p>
      <p class="mt-10 text-sm text-stone">
        Running a bigger operation, 50+ locations or 1,000+ employees?
        <a href="/midmarket" class="underline hover:text-ink">Growing companies</a> ·
        <a href="/enterprise" class="underline hover:text-ink">Large organizations</a>
      </p>
      <div class="mt-10">
        <a href="/audit" class="inline-block rounded-sm bg-signal px-8 py-4 text-sm font-semibold text-paper hover:bg-ink transition-colors">
          Get your free bill review →
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Base>
