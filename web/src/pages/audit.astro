---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Free Bill Review for Your Business | Signal Advisory"
  description="Send one internet, phone, or cell bill. Within 24 hours we send it back marked up with every junk fee, overpriced line, and the rate we would negotiate. No obligation. No savings, no fee."
>
  <Nav />

  <section class="container mx-auto max-w-3xl px-6 py-20 md:px-10 md:py-28">
    <p class="mb-5 text-xs uppercase tracking-[0.2em] text-stone">Free bill review · back within 24 hours</p>
    <h1 class="display text-5xl font-light leading-[0.95] md:text-6xl">
      Send one bill.<br />
      <em class="text-signal not-italic font-medium">We'll show you what you're overpaying.</em>
    </h1>
    <p class="mt-8 text-lg leading-relaxed text-ink/75">
      Any recent invoice from your internet, phone, or cell provider. Within 24 business
      hours you get the same PDF back with three things flagged:
    </p>
    <ul class="mt-6 space-y-3 text-ink/80 text-lg">
      <li class="flex gap-3"><span class="text-signal font-semibold">·</span>Charges we would fight, and the rate we would push for</li>
      <li class="flex gap-3"><span class="text-signal font-semibold">·</span>Hidden fees and surcharges that are not actually taxes (often 8 to 12% of the bill)</li>
      <li class="flex gap-3"><span class="text-signal font-semibold">·</span>Contract terms worth knowing before your next renewal</li>
    </ul>
    <p class="mt-8 text-ink/75">
      No obligation. If the bill looks tight, we tell you that and the review is on us.
      If you want us to negotiate, it is no savings, no fee.
    </p>

    <!-- Form -->
    <form id="audit-form" class="mt-16 grid gap-5 border-t border-ink/10 pt-12">
      <p class="mb-2 text-xs uppercase tracking-[0.2em] text-stone">Request your free review</p>

      <div class="grid gap-5 md:grid-cols-2">
        <div>
          <label class="block text-sm font-medium text-ink mb-2" for="first_name">First name</label>
          <input id="first_name" name="first_name" type="text" required class="w-full border border-ink/20 px-4 py-3 focus:border-signal outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium text-ink mb-2" for="company">Company</label>
          <input id="company" name="company" type="text" required class="w-full border border-ink/20 px-4 py-3 focus:border-signal outline-none" />
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-ink mb-2" for="email">Work email</label>
        <input id="email" name="email" type="email" required class="w-full border border-ink/20 px-4 py-3 focus:border-signal outline-none" />
      </div>

      <div>
        <label class="block text-sm font-medium text-ink mb-2" for="file">Your bill</label>
        <input id="file" name="file" type="file" accept=".pdf,.jpg,.jpeg,.png,.heic,.csv,.xlsx,.xls" class="w-full border border-ink/20 bg-white px-4 py-3 text-sm file:mr-4 file:rounded-sm file:border-0 file:bg-ink file:px-4 file:py-2 file:text-sm file:text-paper" />
        <p class="mt-2 text-xs text-stone">PDF, photo, or spreadsheet, up to 20MB. Don't have it handy? Leave this blank and we'll email you a secure link to send it later.</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-ink mb-2" for="carrier">Who is your provider? (optional)</label>
        <input id="carrier" name="carrier" type="text" placeholder="e.g. Spectrum Business, AT&T, Lumen" class="w-full border border-ink/20 px-4 py-3 focus:border-signal outline-none" />
      </div>

      <div>
        <label class="block text-sm font-medium text-ink mb-2" for="notes">Anything specific to flag? (optional)</label>
        <textarea id="notes" name="notes" rows="3" class="w-full border border-ink/20 px-4 py-3 focus:border-signal outline-none"></textarea>
      </div>

      <p class="text-sm text-stone">
        Your bill uploads securely and never travels as an email attachment. By submitting, you agree to
        our <a href="/privacy" class="text-signal underline">privacy policy</a>. We use
        your bill solely to provide the review you requested and keep uploaded files
        no longer than 90 days.
      </p>

      <button type="submit" class="mt-2 inline-block w-full rounded-sm bg-signal px-6 py-4 text-sm font-semibold text-paper hover:bg-ink transition-colors">
        Get my free bill review
      </button>

      <div id="audit-status" class="hidden text-sm"></div>
    </form>
  </section>

  <Footer />
</Base>

<script>
  const form = document.getElementById('audit-form') as HTMLFormElement;
  const status = document.getElementById('audit-status');
  if (form && status) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const file = fd.get('file');
      const hasFile = file instanceof File && file.size > 0;
      if (!hasFile) fd.delete('file');
      if (hasFile && file.size > 20 * 1024 * 1024) {
        status.className = 'text-sm text-signal font-medium';
        status.textContent = 'That file is over 20MB. Try a PDF or a smaller photo.';
        status.classList.remove('hidden');
        return;
      }
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = hasFile ? 'Uploading…' : 'Sending…';
      try {
        const res = await fetch('https://api.signaladvise.com/audit', {
          method: 'POST',
          body: fd,
        });
        if (res.ok) {
          status.className = 'text-sm text-moss font-medium';
          status.textContent = hasFile
            ? 'Got it. We have your bill and will send the marked-up review within one business day.'
            : 'Got it. Check your inbox in a few minutes for your secure upload link.';
          status.classList.remove('hidden');
          form.reset();
        } else {
          throw new Error(await res.text());
        }
      } catch (err) {
        status.className = 'text-sm text-signal font-medium';
        status.textContent = 'Something went wrong. Email info@signaladvise.com instead and we\'ll pick it up.';
        status.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Get my free bill review';
      }
    });
  }
</script>
