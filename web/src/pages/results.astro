---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Anonymized engagement profiles. Figures confirmed by the owner as real
// engagements (Oct 2026).
const cases = [
  {
    segment: 'Enterprise',
    metric: '$94,000',
    metricLabel: 'first-year savings',
    situation: 'A ten-location manufacturer ran MPLS, backup internet, and voice split across multiple vendors. Renewal dates were scattered and no one held a clean inventory.',
    did: 'Built a site-by-site inventory, priced SD-WAN alternatives, preserved carrier diversity, and renegotiated the renewal terms ahead of cycle.',
    outcome: '$94,000 in first-year savings while keeping full redundancy in place.',
  },
  {
    segment: 'Midmarket',
    metric: '6 to 1',
    metricLabel: 'providers consolidated (a simplification result, not a savings figure)',
    situation: 'A multi-site retail client managed five carrier invoices and a separate UCaaS contract. Renewals were rolling, support escalations went nowhere, and no single vendor owned the relationship.',
    did: 'Consolidated connectivity and voice onto one provider with a single quarterly statement, and renegotiated SLA and credit terms in the process.',
    outcome: 'One bill and one point of accountability, with stronger service-level and credit terms.',
  },
  {
    segment: 'Small Business',
    metric: '23%',
    metricLabel: 'telecom spend reduction',
    situation: 'A single-location business was twelve months from renewal on a three-year carrier contract. The incumbent had quietly raised rates twice and kept billing for line items the company no longer used.',
    did: 'Audited the invoice against the original contract, recovered credits for retired services, and renegotiated the next term early using competitive pressure.',
    outcome: '23% reduction in monthly telecom spend on the same carrier and the same circuits.',
  },
];
---

<Base
  title="Results | Signal Advisory"
  description="Anonymized client results across small business, midmarket, and enterprise. Real engagements. Most clients are anonymized under NDA; St. James is named with permission. References available on request."
>
  <Nav />

  <section class="container mx-auto max-w-4xl px-6 pb-12 pt-24 md:px-10 md:pt-32">
    <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">Results</p>
    <h1 class="display text-3xl font-light leading-[1.15] md:text-5xl">
      What the work
      <em class="text-signal not-italic font-medium">looks like.</em>
    </h1>
    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink/80">
      Real engagements. Most clients are anonymized under NDA; St. James is named with permission. References available on request.
    </p>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-stone">
      Savings are measured against the client's bills before we started, on the carrier's own invoices.
      These are strong outcomes, not a promise. Some bills are already priced well, and then you pay nothing.
    </p>
  </section>

  <section class="container mx-auto max-w-4xl px-6 pb-24 md:px-10">
    <div class="space-y-16">
      {cases.map((c) => (
        <div class="border-t border-ink/10 pt-10">
          <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2 mb-8">
            <p class="text-xs uppercase tracking-[0.15em] text-stone">{c.segment}</p>
            <p class="display text-4xl font-medium text-signal">{c.metric}</p>
            <p class="text-ink/70 text-sm">{c.metricLabel}</p>
          </div>
          <div class="grid gap-8 md:grid-cols-3 text-sm">
            <div>
              <p class="mb-2 text-xs uppercase tracking-[0.12em] text-stone">Situation</p>
              <p class="text-ink/75 leading-relaxed">{c.situation}</p>
            </div>
            <div>
              <p class="mb-2 text-xs uppercase tracking-[0.12em] text-stone">What we did</p>
              <p class="text-ink/75 leading-relaxed">{c.did}</p>
            </div>
            <div>
              <p class="mb-2 text-xs uppercase tracking-[0.12em] text-stone">Outcome</p>
              <p class="text-ink/75 leading-relaxed">{c.outcome}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Named with the client's written permission; quotes verbatim. -->
    <div id="st-james" class="mt-16 border-t border-ink/10 pt-10">
      <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2 mb-8">
        <p class="text-xs uppercase tracking-[0.15em] text-stone">Technology advisory</p>
        <p class="display text-4xl font-medium">St. James Church</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3 text-sm">
        <div>
          <p class="mb-2 text-xs uppercase tracking-[0.12em] text-stone">Situation</p>
          <p class="text-ink/75 leading-relaxed">A busy parish staff found the church website hard to keep current, and routine changes and updates took too much time.</p>
        </div>
        <div>
          <p class="mb-2 text-xs uppercase tracking-[0.12em] text-stone">What we did</p>
          <p class="text-ink/75 leading-relaxed">Listened to how the staff actually works, then rebuilt the website and built a staff portal so they can make changes and process updates themselves.</p>
        </div>
        <div>
          <p class="mb-2 text-xs uppercase tracking-[0.12em] text-stone">Outcome</p>
          <p class="text-ink/75 leading-relaxed">A website the staff can run without outside help, and a simpler way to handle day-to-day updates.</p>
        </div>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        <figure class="glass p-8">
          <blockquote class="display text-xl leading-snug">“Brandon, thank you for making our lives easier and the website so much more manageable.”</blockquote>
          <figcaption class="mt-3 text-sm text-stone">Audrey, Rector, St. James</figcaption>
        </figure>
        <figure class="glass p-8">
          <blockquote class="display text-xl leading-snug">“Brandon, it is so much easier to make changes and process updates through the portal you built us.”</blockquote>
          <figcaption class="mt-3 text-sm text-stone">Office Manager, St. James</figcaption>
        </figure>
      </div>
    </div>

    <div class="mt-16 border-t border-ink/10 pt-10">
      <a href="https://calendly.com/signaladvise-info/30min" target="_blank" rel="noopener" class="mr-6 inline-block rounded-full bg-ink px-8 py-4 text-sm font-semibold text-paper hover:bg-ink/80 transition-colors">
        Book a 30-minute call →
      </a>
      <a href="/audit" class="text-sm text-ink/70 underline underline-offset-4 hover:text-ink">
        or send us one invoice
      </a>
    </div>
  </section>

  <Footer />
</Base>
