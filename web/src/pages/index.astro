---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const CALL = 'https://calendly.com/signaladvise-info/30min';

const services = [
  {
    n: '01',
    title: 'Lowering your bills',
    body: 'Send us your internet, phone, or cell bill. We go through it line by line, call the carrier, and get the price down. You stay with the providers you have, and if we can\'t save you anything, you don\'t owe us anything.',
    link: { href: '/audit', label: 'Free bill review' },
  },
  {
    n: '02',
    title: 'A second opinion on tech decisions',
    body: 'Before you sign a renewal, switch vendors, or rebuild a website, talk it through with someone who isn\'t selling you anything. We recently rebuilt a church\'s website and staff portal so their office could run it themselves.',
    link: { href: '/services', label: 'All services' },
  },
  {
    n: '03',
    title: 'Getting started with AI',
    body: 'Most small businesses don\'t need an AI strategy. They need one or two things that save time on Monday morning. We sit with your team, find those, set them up, and show people how to use them.',
    link: { href: '/services#ai-readiness', label: 'How the AI assessment works' },
  },
];

const inputs = [
  { t: 'Your carrier bills', s: 'Internet · phone · wireless' },
  { t: 'Renewal notices', s: 'Contracts · auto-renewals' },
  { t: 'Busywork', s: 'Email · quotes · data entry' },
];
const outputs = [
  { t: 'Lower monthly bill', s: 'Same providers' },
  { t: 'Better contract terms', s: 'Negotiated before renewal' },
  { t: 'Hours back each week', s: 'AI set up and in use' },
];

const cases = [
  { tag: 'Manufacturing · 10 locations', title: 'A network rebuilt without losing backup lines', body: 'Site-by-site inventory, competitive pricing on newer network options, and renewal terms renegotiated ahead of the deadline.', stat: '$94,000', label: 'first-year savings' },
  { tag: 'Small business · 1 location', title: 'Same carrier, same lines, smaller bill', body: 'We checked the invoice against the original contract, recovered credits for retired services, and renegotiated early.', stat: '23%', label: 'lower monthly spend' },
  { tag: 'Retail · multi-site', title: 'Six providers down to one', body: 'Connectivity and phones consolidated onto one provider with one statement, plus stronger service and credit terms.', stat: '6 → 1', label: 'providers' },
  { tag: 'Church · technology advisory', title: 'A website the office can run themselves', body: '“Brandon, it is so much easier to make changes and process updates through the portal you built us.” Office Manager, St. James', stat: 'St. James', label: 'named with permission' },
];

const steps = [
  { n: '01', title: 'We talk for 30 minutes', body: 'You tell us what you pay for and what\'s bugging you. We ask a lot of questions.' },
  { n: '02', title: 'You get it in writing', body: 'What we\'d change, what it should save you, and what we\'d charge. You know the price before we start.' },
  { n: '03', title: 'We do the work', body: 'If you say go, we handle the calls and the setup, then show you the before and after.' },
];

const serviceSchema = [
  'Telecom and technology cost reduction',
  'Carrier contract renewal negotiation',
  'Independent technology advisory',
  'AI readiness assessment and adoption for small business',
].map((name) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: name,
  provider: { '@id': 'https://signaladvise.com/#org' },
  areaServed: { '@type': 'Country', name: 'United States' },
}));
---

<Base
  title="Signal Advisory | Lower Technology Costs and AI That Gets Used, Kansas City"
  description="Independent technology advisor in Kansas City. We cut telecom and technology costs, advise on the systems you run, and help small businesses adopt AI that actually gets used. 25+ years inside the major carriers."
  jsonLd={serviceSchema}
>
  <Nav />

  <!-- Hero over the particle wave, with a diagram of how work flows through an engagement. -->
  <section class="relative overflow-hidden">
    <canvas id="wave" class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <div class="relative container mx-auto max-w-6xl px-4 pb-16 pt-10 md:px-10 md:pt-16">
      <p class="mb-8 inline-flex items-center gap-2 rounded-md border border-ink/15 bg-ink/[0.04] px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.15em] text-stone">
        <span class="h-1.5 w-1.5 rounded-full bg-signal"></span> Telecom · Technology · AI <span class="text-ink/30">/</span> Kansas City
      </p>
      <h1 data-type class="display max-w-4xl text-4xl font-medium leading-[1.05] tracking-tight md:text-6xl lg:text-7xl">
        We cut what you pay for tech, then put <span class="text-signal">AI to work</span> where it pays back.
      </h1>
      <div class="mt-8 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
        <p class="max-w-xl text-lg leading-relaxed text-ink/70">
          We spent 25 years inside the big carriers, so we know how the bills are built and where
          the room is. Now we work for small and mid-sized businesses, measured in dollars saved
          and hours given back.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={CALL} target="_blank" rel="noopener" class="inline-flex items-center gap-3 rounded-md bg-signal py-2 pl-5 pr-2 text-sm font-semibold text-paper hover:bg-signal/90">
            Book a 30-minute call <span class="grid h-7 w-7 place-items-center rounded bg-paper/20">↗</span>
          </a>
          <a href="/audit" class="inline-flex items-center gap-3 rounded-md border border-ink/20 bg-paper/60 py-2 pl-5 pr-2 text-sm font-medium hover:border-ink/50">
            Free bill review <span class="grid h-7 w-7 place-items-center rounded bg-ink/10">↗</span>
          </a>
        </div>
      </div>

      <!-- Flow diagram: illustrative, not live data. -->
      <div data-frame class="mt-14 rounded-xl border border-ink/15 bg-paper/70 p-4 backdrop-blur-sm md:p-8">
        <div class="relative grid gap-4 md:h-[280px] md:grid-cols-[1fr_1.3fr_1fr] md:gap-16">
          <svg class="pointer-events-none absolute inset-0 hidden h-full w-full md:block" viewBox="0 0 1000 280" preserveAspectRatio="none" aria-hidden="true">
            <g fill="none" stroke-width="1.2" vector-effect="non-scaling-stroke">
              <path class="flow" d="M250 45 C 330 45, 330 140, 380 140" stroke="rgb(var(--ink) / 0.25)"/>
              <path class="flow flow-hot" d="M250 140 L 380 140" stroke="rgb(var(--signal))"/>
              <path class="flow" d="M250 235 C 330 235, 330 140, 380 140" stroke="rgb(var(--ink) / 0.25)"/>
              <path class="flow" d="M620 140 C 670 140, 670 45, 750 45" stroke="rgb(var(--ink) / 0.25)"/>
              <path class="flow" d="M620 140 L 750 140" stroke="rgb(var(--ink) / 0.25)"/>
              <path class="flow flow-hot" d="M620 140 C 670 140, 670 235, 750 235" stroke="rgb(var(--signal))"/>
            </g>
          </svg>
          <div class="relative flex flex-col justify-between gap-3">
            {inputs.map((n, i) => (
              <div class={`node ${i === 1 ? 'border-signal/70' : ''}`}><span class="node-t">{n.t}</span><span class="node-s">{n.s}</span></div>
            ))}
          </div>
          <div class="relative flex items-center">
            <div class="w-full rounded-lg border border-ink/20 bg-paper p-5 shadow-[0_0_60px_rgb(var(--signal)/0.12)]">
              <div class="mb-4 flex items-center justify-between">
                <span class="flex items-center gap-2 text-sm font-semibold"><img src="/favicon.svg" alt="" class="h-5 w-5 rounded" /> Signal Advisory</span>
                <span class="flex items-center gap-1.5 font-mono text-[10px] uppercase text-stone"><span class="h-1.5 w-1.5 animate-pulse rounded-full bg-signal"></span>Working</span>
              </div>
              <p class="font-mono text-xs text-ink/80"><span class="text-signal">›</span> <span id="agent-line">Auditing carrier invoice, 47 line items</span></p>
              <div class="mt-4 h-0.5 w-full overflow-hidden rounded bg-ink/10"><div class="bar h-full w-1/3 bg-signal"></div></div>
              <div class="mt-4 flex flex-wrap gap-1.5 font-mono text-[10px] uppercase text-stone">
                <span class="rounded border border-ink/15 px-1.5 py-0.5">Audit</span><span class="rounded border border-ink/15 px-1.5 py-0.5">Negotiate</span><span class="rounded border border-ink/15 px-1.5 py-0.5">Automate</span><span class="rounded border border-ink/15 px-1.5 py-0.5">Train</span>
              </div>
            </div>
          </div>
          <div class="relative flex flex-col justify-between gap-3">
            {outputs.map((n, i) => (
              <div class={`node ${i === 2 ? 'border-signal/70' : ''}`}><span class="node-t">{n.t}</span><span class="node-s">{n.s}</span></div>
            ))}
          </div>
        </div>
        <div class="mt-6 flex flex-wrap justify-between gap-2 border-t border-ink/10 pt-4 font-mono text-[10px] uppercase tracking-[0.15em] text-stone">
          <span>Example of a typical engagement</span>
          <span>25+ yrs inside carriers · 200+ providers · 24h bill review</span>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Dotted wave field, drawn in perspective. Static frame for reduced motion;
    // paused while off-screen or the tab is hidden.
    const c = document.getElementById('wave') as HTMLCanvasElement | null;
    const ctx = c?.getContext('2d');
    if (c && ctx) {
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let w = 0, h = 0, t = 0;
      let visible = true;
      const size = () => {
        const r = devicePixelRatio || 1;
        w = c.clientWidth; h = c.clientHeight;
        c.width = w * r; c.height = h * r;
        ctx.setTransform(r, 0, 0, r, 0, 0);
      };
      const draw = () => {
        ctx.clearRect(0, 0, w, h);
        const cols = 90, rows = 34;
        for (let j = 0; j < rows; j++) {
          const z = j / rows;
          const persp = 0.35 + z * 0.9;
          for (let i = 0; i < cols; i++) {
            const x0 = (i / (cols - 1) - 0.5) * 2;
            const y = Math.sin(x0 * 3 + t + j * 0.35) * 0.5 + Math.cos(x0 * 5 - t * 0.7 + j * 0.2) * 0.25;
            const px = w / 2 + x0 * w * 0.75 * persp;
            const py = h * 0.3 + z * h * 0.75 + y * 110 * persp;
            ctx.fillStyle = `rgba(255,255,255,${0.08 + z * 0.55})`;
            ctx.fillRect(px, py, 1.6 * persp, 1.6 * persp);
          }
        }
        t += 0.012;
        if (!still && visible && !document.hidden) requestAnimationFrame(draw);
      };
      const resume = () => { if (!still && visible && !document.hidden) requestAnimationFrame(draw); };
      new IntersectionObserver(([e]) => {
        const was = visible;
        visible = e.isIntersecting;
        if (!was) resume();
      }).observe(c);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) resume(); });
      size();
      addEventListener('resize', () => { size(); if (still) draw(); });
      draw();
    }

    // Cycle the example status line in the flow diagram.
    const line = document.getElementById('agent-line');
    const msgs = [
      'Auditing carrier invoice, 47 line items',
      'Flagging fees that are not actually taxes',
      'Comparing your rate to current market pricing',
      'Drafting the AI setup for your quote requests',
      'Renewal coming up in 90 days, building the bid',
    ];
    if (line && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let k = 0;
      setInterval(() => { k = (k + 1) % msgs.length; line.textContent = msgs[k]; }, 2600);
    }
  </script>

  <!-- Carriers we negotiate with (the providers, not clients). -->
  <section class="border-y border-ink/10 py-6">
    <div class="container mx-auto flex max-w-6xl flex-wrap items-center gap-x-12 gap-y-3 px-4 md:px-10">
      <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone">We negotiate with</p>
      {['AT&T', 'Verizon', 'Lumen', 'Spectrum', 'Comcast', 'Cox', 'T-Mobile'].map((c) => (
        <span class="display text-xl text-ink/50">{c}</span>
      ))}
    </div>
  </section>

  <!-- [01] The problem, with a cost calculator. Light section. -->
  <section class="bg-[#f3f1ec] py-24 text-[#111]">
    <div class="container mx-auto grid max-w-6xl gap-12 px-4 md:grid-cols-2 md:px-10">
      <div>
        <p class="mb-6 font-mono text-[11px] uppercase tracking-[0.15em] text-[#666]"><span class="text-signal">● [01]</span> The problem</p>
        <h2 data-type class="display text-4xl font-medium leading-[1.05] tracking-tight md:text-5xl">Your team has become the paperwork department.</h2>
        <p class="mt-6 max-w-md text-[#444] leading-relaxed">
          Every week, good people copy numbers between inboxes and spreadsheets, chase the same
          follow-ups, and nobody has time to read the phone bill. It adds up quietly.
        </p>
        <ul class="mt-8 max-w-md divide-y divide-[#111]/10 border-y border-[#111]/10 text-sm">
          <li class="flex gap-3 py-3"><span class="text-signal">●</span>Bills that auto-renew at a higher rate every year</li>
          <li class="flex gap-3 py-3"><span class="text-signal">●</span>Copying data between tools that don't talk to each other</li>
          <li class="flex gap-3 py-3"><span class="text-signal">●</span>Retyping the same quotes, reports, and replies</li>
        </ul>
      </div>
      <div data-frame class="rounded-xl bg-[#0b0b0c] p-6 text-[#f0f0f0] shadow-2xl md:p-8" id="calc">
        <p class="mb-6 font-mono text-[10px] uppercase tracking-[0.2em] text-[#888]"><span class="text-signal">●</span> What repetitive work costs you</p>
        <label class="block text-sm">People doing repetitive work <output class="float-right font-mono" data-o="p">4</output>
          <input type="range" min="1" max="50" value="4" data-i="p" class="mt-3 w-full accent-[rgb(var(--signal))]" /></label>
        <label class="mt-6 block text-sm">Hours each per week <output class="float-right font-mono" data-o="h">5 h</output>
          <input type="range" min="1" max="20" value="5" data-i="h" class="mt-3 w-full accent-[rgb(var(--signal))]" /></label>
        <label class="mt-6 block text-sm">Hourly cost, with benefits <output class="float-right font-mono" data-o="r">$35</output>
          <input type="range" min="15" max="150" value="35" data-i="r" class="mt-3 w-full accent-[rgb(var(--signal))]" /></label>
        <div class="mt-8 grid grid-cols-2 gap-4 border-t border-white/10 pt-6">
          <div><p class="font-mono text-[10px] uppercase tracking-[0.2em] text-[#888]">Hours / year</p><p class="display text-4xl font-medium" data-o="hy">960</p></div>
          <div><p class="font-mono text-[10px] uppercase tracking-[0.2em] text-[#888]">Cost / year</p><p class="display text-4xl font-medium text-signal" data-o="cy">$33,600</p></div>
        </div>
        <p class="mt-4 text-xs text-[#888]">Based on 48 working weeks. AI won't take all of it. Our job is finding the part it can.</p>
        <a href={CALL} target="_blank" rel="noopener" class="mt-6 flex items-center justify-between rounded-md bg-signal py-2 pl-5 pr-2 text-sm font-semibold text-paper hover:bg-signal/90">
          Talk through your numbers <span class="grid h-7 w-7 place-items-center rounded bg-paper/20">↗</span>
        </a>
      </div>
    </div>
  </section>

  <script>
    // Cost calculator: whole numbers only; display formatting via toLocaleString.
    const root = document.getElementById('calc');
    if (root) {
      const val = (k: string) => Number((root.querySelector(`[data-i="${k}"]`) as HTMLInputElement).value);
      const out = (k: string, v: string) => { const el = root.querySelector(`[data-o="${k}"]`); if (el) el.textContent = v; };
      const update = () => {
        const p = val('p'), h = val('h'), r = val('r');
        const hours = p * h * 48;
        out('p', String(p)); out('h', `${h} h`); out('r', `$${r}`);
        out('hy', hours.toLocaleString('en-US'));
        out('cy', `$${(hours * r).toLocaleString('en-US')}`);
      };
      root.addEventListener('input', update);
      update();
    }
  </script>

  <!-- [02] Selected work: figures confirmed by the owner as real engagements. -->
  <section class="py-24">
    <div class="container mx-auto max-w-6xl px-4 md:px-10">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="mb-6 font-mono text-[11px] uppercase tracking-[0.15em] text-stone"><span class="text-signal">● [02]</span> Selected work</p>
          <h2 data-type class="display text-4xl font-medium leading-[1.05] tracking-tight md:text-5xl">Results you can put<br />in front of your boss.</h2>
        </div>
        <a href="/results" class="inline-flex items-center gap-3 rounded-md border border-ink/20 py-2 pl-5 pr-2 text-sm hover:border-ink/50">All case studies <span class="grid h-7 w-7 place-items-center rounded bg-ink/10">↗</span></a>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {cases.map((c) => (
          <a data-frame href="/results" class="glass group flex flex-col p-8 transition-colors hover:border-signal/50">
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-signal">{c.tag}</p>
            <h3 data-type class="display mt-4 text-2xl font-medium leading-snug">{c.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/65">{c.body}</p>
            <div class="mt-8 border-t border-ink/10 pt-5">
              <p data-count class="display text-4xl font-medium">{c.stat}</p>
              <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone">{c.label}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="what-we-do" class="py-16">
    <div class="container mx-auto max-w-6xl px-4 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">What we do</p>
      <h2 data-type id="ai" class="display mb-12 max-w-3xl scroll-mt-24 text-3xl font-light leading-tight md:text-5xl">
        What we can help with.
      </h2>
      <div class="grid gap-4 md:grid-cols-3">
        {services.map((s) => (
          <div data-frame class="glass flex flex-col p-8">
            <p class="mb-6 font-mono text-xs text-stone">{s.n}</p>
            <h3 data-type class="display mb-3 text-2xl font-normal">{s.title}</h3>
            <p class="flex-1 text-[15px] leading-relaxed text-ink/70">{s.body}</p>
            <a href={s.link.href} class="mt-8 text-sm font-medium underline underline-offset-4 hover:text-ink/70">{s.link.label} →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How an engagement works -->
  <section id="how-it-works" class="py-16">
    <div class="container mx-auto max-w-6xl px-4 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">How it works</p>
      <h2 data-type class="display mb-12 max-w-3xl text-3xl font-light leading-tight md:text-5xl">How working with us goes.</h2>
      <div data-frame class="grid gap-10 border-t border-ink/10 pt-10 md:grid-cols-3">
        {steps.map((s) => (
          <div>
            <p class="mb-4 font-mono text-xs text-stone">{s.n}</p>
            <p class="display mb-3 text-xl">{s.title}</p>
            <p class="text-[15px] leading-relaxed text-ink/70">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The advisor: credentials, brand-first (no personal name, by owner request). -->
  <section id="why" class="py-16">
    <div class="container mx-auto max-w-6xl px-4 md:px-10">
      <div data-frame class="glass grid gap-10 p-8 md:grid-cols-5 md:p-12">
        <div class="md:col-span-3">
          <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">Your advisor</p>
          <h2 data-type class="display mb-6 text-3xl font-light leading-tight md:text-4xl">Who you'll be working with.</h2>
          <p class="mb-5 leading-relaxed text-ink/75">
            Signal Advisory is a small firm based in Kansas City. Our founder spent more than
            25 years inside the major U.S. carriers, pricing and writing the same contracts our
            clients now ask us to fix.
          </p>
          <p class="leading-relaxed text-ink/75">
            When you call, you get the person doing the work.
          </p>
        </div>
        <ul class="space-y-5 border-t border-ink/10 pt-8 text-sm md:col-span-2 md:border-l md:border-t-0 md:pl-10 md:pt-0">
          <li><span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-stone">Experience</span>25+ years inside the major U.S. carriers</li>
          <li><span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-stone">Reach</span>Competitive bids across 200+ providers</li>
          <li><span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-stone">Procurement</span>NDA, MSA, W-9 and insurance on request</li>
          <li><span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-stone">References</span>Available on request, plus <a href="/results" class="underline underline-offset-4">case studies</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section id="contact" class="py-24">
    <div class="container mx-auto max-w-3xl px-6 text-center md:px-10">
      <h2 data-type class="display mb-6 text-3xl font-light leading-tight md:text-5xl">Want to talk it through?</h2>
      <p class="mb-10 text-ink/70">Grab 30 minutes on the calendar. If we can't help, we'll tell you.</p>
      <a href={CALL} target="_blank" rel="noopener" class="inline-block rounded-full bg-ink px-8 py-4 text-sm font-semibold text-paper hover:bg-ink/80 transition-colors">
        Book a 30-minute call →
      </a>
      <p class="mt-6 text-sm text-ink/60">
        Or call <a href="tel:+18163553350" class="underline">816-355-3350</a> · <a href="mailto:info@signaladvise.com" class="underline">info@signaladvise.com</a>
      </p>
    </div>
  </section>

  <script>
    // "Agents build the page": each time a section scrolls into view, labeled
    // agent cursors work over it, headings type themselves, panels draw in one
    // by one, and numbers count up. It resets when the section leaves the
    // screen, so it replays on the way back. Skipped for reduced motion.
    const AGENTS = [
      ['Research', '#3b82f6'], ['Data', '#f5c542'], ['Design', '#ec4899'],
      ['Writer', '#22c55e'], ['Agent 01', '#ff5c26'],
    ];
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const timers = new WeakMap<HTMLElement, number[]>();
    const later = (host: HTMLElement, fn: () => void, ms: number) => {
      const list = timers.get(host) || [];
      list.push(window.setTimeout(fn, ms));
      timers.set(host, list);
    };

    const spawn = (host: HTMLElement) => {
      const picks = AGENTS.slice().sort(() => Math.random() - 0.5).slice(0, 3);
      picks.forEach(([name, color], i) => {
        const a = document.createElement('span');
        a.className = 'agent';
        a.innerHTML = `<svg width="12" height="12" viewBox="0 0 12 12"><path d="M0 0 L12 5 L5 6 L4 12 Z" fill="${color}"/></svg><b style="background:${color}">${name}</b>`;
        const w = host.clientWidth, h = host.clientHeight;
        a.style.transform = `translate(${Math.random() * w}px, ${h + 40}px)`;
        host.appendChild(a);
        const hop = (n: number) => {
          if (n === 0) { a.style.opacity = '0'; later(host, () => a.remove(), 600); return; }
          a.style.transform = `translate(${Math.random() * w * 0.9}px, ${Math.random() * h * 0.9}px)`;
          later(host, () => hop(n - 1), 700 + Math.random() * 500);
        };
        later(host, () => { a.style.opacity = '1'; hop(4); }, 150 + i * 250);
      });
    };

    const type = (host: HTMLElement, el: HTMLElement, delay: number) => {
      el.dataset.html ??= el.innerHTML;
      const text = el.textContent || '';
      el.style.minHeight = `${el.offsetHeight}px`;
      el.textContent = '';
      el.classList.add('typing');
      let i = 0;
      const tick = () => {
        i += 2;
        el.textContent = text.slice(0, i);
        if (i < text.length) later(host, tick, 18);
        else { el.innerHTML = el.dataset.html!; el.classList.remove('typing'); }
      };
      later(host, tick, delay);
    };

    const count = (host: HTMLElement, el: HTMLElement, delay: number) => {
      el.dataset.final ??= el.textContent || '';
      const m = el.dataset.final!.match(/^(\D*)([\d,]+)(.*)$/);
      if (!m) return;
      const target = Number(m[2].replace(/,/g, ''));
      el.textContent = `${m[1]}0${m[3]}`;
      const steps = 30;
      for (let k = 1; k <= steps; k++) {
        later(host, () => {
          const v = Math.round((target * k) / steps);
          el.textContent = `${m[1]}${v.toLocaleString('en-US')}${m[3]}`;
        }, delay + k * 35);
      }
    };

    const build = (host: HTMLElement) => {
      spawn(host);
      host.querySelectorAll<HTMLElement>('[data-frame]').forEach((el, i) => {
        later(host, () => el.classList.replace('unframed', 'framed'), i * 220);
      });
      host.querySelectorAll<HTMLElement>('[data-type]').forEach((el, i) => type(host, el, i * 220));
      host.querySelectorAll<HTMLElement>('[data-count]').forEach((el, i) => count(host, el, 400 + i * 220));
    };

    const reset = (host: HTMLElement) => {
      (timers.get(host) || []).forEach(clearTimeout);
      timers.delete(host);
      host.querySelectorAll('.agent').forEach((a) => a.remove());
      host.querySelectorAll<HTMLElement>('[data-type]').forEach((el) => {
        if (el.dataset.html) el.innerHTML = el.dataset.html;
        el.classList.remove('typing');
      });
      host.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        if (el.dataset.final) el.textContent = el.dataset.final;
      });
      host.querySelectorAll<HTMLElement>('[data-frame]').forEach((el) => el.classList.replace('framed', 'unframed'));
    };

    if (!calm) {
      const hosts = new Set<HTMLElement>();
      document.querySelectorAll<HTMLElement>('[data-type],[data-frame],[data-count]').forEach((el) => {
        if (el.hasAttribute('data-frame')) el.classList.add('unframed');
        const host = el.closest('section') as HTMLElement | null;
        if (host) hosts.add(host);
      });
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          const host = e.target as HTMLElement;
          if (e.isIntersecting && e.intersectionRatio >= 0.2 && !host.dataset.built) {
            host.dataset.built = '1';
            build(host);
          } else if (!e.isIntersecting && host.dataset.built) {
            delete host.dataset.built;
            reset(host);
          }
        }
      }, { threshold: [0, 0.2] });
      hosts.forEach((h) => io.observe(h));
    }
  </script>

  <Footer />
</Base>
