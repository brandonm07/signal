---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const CALL = 'https://calendly.com/signaladvise-info/30min';

const services = [
  {
    n: '01',
    title: 'Telecom and technology costs',
    body: 'Internet, phone, wireless, and cloud bills audited line by line and renegotiated. You keep your providers. No savings, no fee.',
    link: { href: '/audit', label: 'Free bill review' },
  },
  {
    n: '02',
    title: 'Technology advisory',
    body: 'Independent advice on renewals, vendor choices, and systems your team can actually run, from carrier contracts to websites and staff portals.',
    link: { href: '/services', label: 'All services' },
  },
  {
    n: '03',
    title: 'AI adoption',
    body: 'Start with an AI Readiness Assessment: we map where your team loses hours, pick the first one or two uses that pay back, and set them up with your existing tools.',
    link: { href: '/services#ai-readiness', label: 'AI Readiness Assessment' },
  },
];

const steps = [
  { n: '01', title: 'A 30-minute call', body: 'We learn how your business runs, what you spend, and where the friction is. No pitch deck.' },
  { n: '02', title: 'A written assessment', body: 'You get a clear list of what we would change, what it saves or earns, and what it costs. Fixed scope, priced up front.' },
  { n: '03', title: 'We do the work', body: 'We negotiate, set up, and train, then report results against the starting point. You decide every step.' },
];

const serviceSchema = [
  'Telecom and technology cost reduction',
  'Carrier contract renewal negotiation',
  'Independent technology advisory',
  'AI readiness assessment and adoption for small business',
].map((name) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: name,
  provider: { '@id': 'https://signaladvise.com/#org' },
  areaServed: { '@type': 'Country', name: 'United States' },
}));
---

<Base
  title="Signal Advisory | Lower Technology Costs and AI That Gets Used, Kansas City"
  description="Independent technology advisor in Kansas City. We cut telecom and technology costs, advise on the systems you run, and help small businesses adopt AI that actually gets used. 25+ years inside the major carriers."
  jsonLd={serviceSchema}
>
  <Nav />

  <!-- Hero: glass panel over an animated particle wave (canvas, see script below). -->
  <section class="relative overflow-hidden">
    <canvas id="wave" class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <div class="relative container mx-auto max-w-6xl px-4 pb-16 pt-10 md:px-10 md:pb-24 md:pt-16">
      <div class="glass p-6 md:p-12">
        <div class="mb-10 flex flex-wrap items-center justify-between gap-4 border-b border-ink/10 pb-5 font-mono text-[11px] uppercase tracking-[0.2em] text-stone">
          <span class="flex flex-wrap gap-x-6 gap-y-1"><span>:Costs</span><span>:Technology</span><span>:AI</span></span>
          <span class="text-ink">S · I · G · N · A · L</span>
          <span class="hidden sm:inline">Kansas City, MO</span>
        </div>
        <div class="grid gap-12 md:grid-cols-[1fr_auto] md:items-end">
          <div>
            <h1 class="display text-3xl font-light leading-[1.1] md:text-5xl lg:text-[3.6rem]">
              Lower technology costs. AI that actually gets used.
              <span class="text-ink/45">One independent advisor.</span>
            </h1>
            <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink/75">
              We spent 25+ years inside the major carriers. Now we sit on your side of the
              table: cutting what you pay for technology, and putting AI to work where it
              pays back.
            </p>
            <div class="mt-10 flex flex-wrap items-center gap-6">
              <a href={CALL} target="_blank" rel="noopener" class="inline-block rounded-full bg-ink px-8 py-4 text-sm font-semibold text-paper hover:bg-ink/80 transition-colors">
                Book a 30-minute call →
              </a>
              <a href="/audit" class="text-sm text-ink/70 underline underline-offset-4 hover:text-ink">or start with a free bill review</a>
            </div>
          </div>
          <dl class="grid grid-cols-3 gap-6 border-t border-ink/10 pt-8 md:grid-cols-1 md:border-l md:border-t-0 md:pl-10 md:pt-0">
            <div><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone">Inside carriers</dt><dd class="display text-4xl font-light md:text-6xl">25+<span class="text-2xl text-ink/40"> yrs</span></dd></div>
            <div><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone">Providers bid</dt><dd class="display text-4xl font-light text-ink/60 md:text-6xl">200+</dd></div>
            <div><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone">Bill review</dt><dd class="display text-4xl font-light text-ink/30 md:text-6xl">24h</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Dotted wave field, drawn in perspective. Static frame for reduced motion;
    // paused while off-screen or the tab is hidden.
    const c = document.getElementById('wave') as HTMLCanvasElement | null;
    const ctx = c?.getContext('2d');
    if (c && ctx) {
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let w = 0, h = 0, t = 0;
      let visible = true;
      const size = () => {
        const r = devicePixelRatio || 1;
        w = c.clientWidth; h = c.clientHeight;
        c.width = w * r; c.height = h * r;
        ctx.setTransform(r, 0, 0, r, 0, 0);
      };
      const draw = () => {
        ctx.clearRect(0, 0, w, h);
        const cols = 90, rows = 34;
        for (let j = 0; j < rows; j++) {
          const z = j / rows;
          const persp = 0.35 + z * 0.9;
          for (let i = 0; i < cols; i++) {
            const x0 = (i / (cols - 1) - 0.5) * 2;
            const y = Math.sin(x0 * 3 + t + j * 0.35) * 0.5 + Math.cos(x0 * 5 - t * 0.7 + j * 0.2) * 0.25;
            const px = w / 2 + x0 * w * 0.75 * persp;
            const py = h * 0.3 + z * h * 0.75 + y * 110 * persp;
            ctx.fillStyle = `rgba(255,255,255,${0.08 + z * 0.55})`;
            ctx.fillRect(px, py, 1.6 * persp, 1.6 * persp);
          }
        }
        t += 0.012;
        if (!still && visible && !document.hidden) requestAnimationFrame(draw);
      };
      const resume = () => { if (!still && visible && !document.hidden) requestAnimationFrame(draw); };
      new IntersectionObserver(([e]) => {
        const was = visible;
        visible = e.isIntersecting;
        if (!was) resume();
      }).observe(c);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) resume(); });
      size();
      addEventListener('resize', () => { size(); if (still) draw(); });
      draw();
    }
  </script>

  <!-- Proof: figures from /results, confirmed by the owner as real engagements. -->
  <section class="py-16">
    <div class="container mx-auto max-w-6xl px-4 md:px-10">
      <p class="mb-8 text-xs uppercase tracking-[0.2em] text-stone">Recent results</p>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="glass p-8">
          <p class="display text-5xl font-light">$94,000</p>
          <p class="mt-3 text-sm text-ink/70">first-year savings for a ten-location manufacturer, with full redundancy kept</p>
        </div>
        <div class="glass p-8">
          <p class="display text-5xl font-light">23%</p>
          <p class="mt-3 text-sm text-ink/70">lower monthly telecom spend for a single-location business, same carrier, same service</p>
        </div>
        <div class="glass p-8">
          <p class="display text-5xl font-light">6 → 1</p>
          <p class="mt-3 text-sm text-ink/70">providers consolidated for a multi-site retailer: one bill, one point of accountability</p>
        </div>
      </div>
      <a href="/results" class="mt-8 inline-block text-sm font-medium underline underline-offset-4 hover:text-ink/70">Read the case studies →</a>
    </div>
  </section>

  <!-- Services -->
  <section id="what-we-do" class="py-16">
    <div class="container mx-auto max-w-6xl px-4 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">What we do</p>
      <h2 id="ai" class="display mb-12 max-w-3xl scroll-mt-24 text-3xl font-light leading-tight md:text-5xl">
        Three ways we make technology work harder for your business.
      </h2>
      <div class="grid gap-4 md:grid-cols-3">
        {services.map((s) => (
          <div class="glass flex flex-col p-8">
            <p class="mb-6 font-mono text-xs text-stone">{s.n}</p>
            <h3 class="display mb-3 text-2xl font-normal">{s.title}</h3>
            <p class="flex-1 text-[15px] leading-relaxed text-ink/70">{s.body}</p>
            <a href={s.link.href} class="mt-8 text-sm font-medium underline underline-offset-4 hover:text-ink/70">{s.link.label} →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How an engagement works -->
  <section id="how-it-works" class="py-16">
    <div class="container mx-auto max-w-6xl px-4 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">How it works</p>
      <h2 class="display mb-12 max-w-3xl text-3xl font-light leading-tight md:text-5xl">Clear scope. Measured results.</h2>
      <div class="grid gap-10 border-t border-ink/10 pt-10 md:grid-cols-3">
        {steps.map((s) => (
          <div>
            <p class="mb-4 font-mono text-xs text-stone">{s.n}</p>
            <p class="display mb-3 text-xl">{s.title}</p>
            <p class="text-[15px] leading-relaxed text-ink/70">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The advisor: credentials, brand-first (no personal name, by owner request). -->
  <section id="why" class="py-16">
    <div class="container mx-auto max-w-6xl px-4 md:px-10">
      <div class="glass grid gap-10 p-8 md:grid-cols-5 md:p-12">
        <div class="md:col-span-3">
          <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">Your advisor</p>
          <h2 class="display mb-6 text-3xl font-light leading-tight md:text-4xl">25 years on the other side of the table.</h2>
          <p class="mb-5 leading-relaxed text-ink/75">
            Signal Advisory is led by a technology advisor with more than 25 years inside the major
            U.S. carriers, pricing and structuring the contracts businesses sign. We know which fees
            are negotiable and what a carrier will concede when someone who knows the playbook asks.
          </p>
          <p class="leading-relaxed text-ink/75">
            Every client works with that same senior advisor. Not a call center, not a franchise.
          </p>
        </div>
        <ul class="space-y-5 border-t border-ink/10 pt-8 text-sm md:col-span-2 md:border-l md:border-t-0 md:pl-10 md:pt-0">
          <li><span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-stone">Experience</span>25+ years inside the major U.S. carriers</li>
          <li><span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-stone">Reach</span>Competitive bids across 200+ providers</li>
          <li><span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-stone">Procurement</span>NDA, MSA, W-9 and insurance on request</li>
          <li><span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-stone">References</span>Available on request, plus <a href="/results" class="underline underline-offset-4">case studies</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section id="contact" class="py-24">
    <div class="container mx-auto max-w-3xl px-6 text-center md:px-10">
      <h2 class="display mb-6 text-3xl font-light leading-tight md:text-5xl">One call to see where you stand.</h2>
      <p class="mb-10 text-ink/70">30 minutes, no obligation. You leave with a clear next step either way.</p>
      <a href={CALL} target="_blank" rel="noopener" class="inline-block rounded-full bg-ink px-8 py-4 text-sm font-semibold text-paper hover:bg-ink/80 transition-colors">
        Book a 30-minute call →
      </a>
      <p class="mt-6 text-sm text-ink/60">
        Or call <a href="tel:+18163553350" class="underline">816-355-3350</a> · <a href="mailto:info@signaladvise.com" class="underline">info@signaladvise.com</a>
      </p>
    </div>
  </section>

  <Footer />
</Base>
