---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    tag: '01',
    title: 'Provider negotiation',
    body: 'We negotiate directly with every major U.S. provider on your behalf. Rate is one variable. Term length, exit rights, redundancy, and rate-protection clauses move more money over the life of a contract.',
  },
  {
    tag: '02',
    title: 'Vendor consolidation',
    body: 'Mid-market companies typically pay four to six providers for services that should sit with one or two. We inventory every contract, renewal date, and monthly cost, then make the consolidation decisions straightforward.',
  },
  {
    tag: '03',
    title: 'Telecom expense management',
    body: 'Every invoice, audited against every contract, every month. On a typical mid-market footprint this work recovers three to six percent of annual telecom spend.',
  },
  {
    tag: '04',
    title: 'Ongoing advisory',
    body: 'Hourly or monthly retainer covering the technology decisions your team makes between major engagements.',
  },
];

const helpWith = [
  {
    title: 'Vendor decisions',
    body: 'Choose the right internet, phone, cloud, mobile, and carrier partners.',
  },
  {
    title: 'Contract negotiations',
    body: 'Avoid bad renewals, hidden fees, and terms that limit your options.',
  },
  {
    title: 'Cost reduction',
    body: 'Find services you no longer need, pricing that is too high, and billing issues.',
  },
  {
    title: 'Technology planning',
    body: 'Help leadership and IT make informed decisions before changes are made.',
  },
  {
    title: 'Vendor management',
    body: 'Reduce confusion, finger-pointing, and unnecessary complexity.',
  },
];

const steps = [
  { n: '01', t: 'Send one invoice or contract' },
  { n: '02', t: 'We mark up what we would challenge' },
  { n: '03', t: 'You decide whether the savings justify next steps' },
];

const proof = [
  { metric: '$94,000', label: 'annual savings, year one' },
  { metric: '6 → 1', label: 'vendor relationships consolidated' },
  { metric: '23%', label: 'telecom spend reduction' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does an independent technology broker do?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'An independent technology broker represents the buyer in technology purchasing decisions. We inventory every contract a business has — internet, phone, mobile, cloud, security — then put providers in competition for the renewal. The result is lower cost, better contract terms, and fewer vendors to manage. We are independent across every major U.S. provider rather than tied to any one of them.',
      },
    },
    {
      '@type': 'Question',
      name: 'How much can a business save by auditing telecom and technology invoices?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A typical mid-market audit recovers three to six percent of annual telecom and technology spend through billing errors, unused services, and renegotiation. Small businesses commonly save 15 to 30 percent on a single internet or phone contract when it is put out to bid.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I have to switch carriers to work with Signal Advisory?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Many of our engagements end with the client staying on the incumbent carrier at materially better rates and terms. The leverage is in being willing to switch, not in actually switching.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does Signal Advisory get paid?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Engagements run on three models: a flat-fee contract review, hourly project work, or a monthly retainer for ongoing advisory. On brokered transactions we are compensated by the carrier through our master agency relationships, which is the standard model in the channel. For clients who prefer a fee-only arrangement, we can rebate the brokerage commission against a flat advisory fee.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is Signal Advisory different from a master agent?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We work independently across every major U.S. provider rather than steering business to any one carrier. We stay involved through implementation, billing disputes, and the next renewal — most agents disappear after signature. We negotiate the contract terms that protect the buyer, not just the rate that closes the deal.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where is Signal Advisory based?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Signal Advisory is based in Kansas City, Missouri, and serves clients across the United States. Reach Brandon Murphy at 816-355-3350 or brandon@signaladvise.com.',
      },
    },
  ],
};

const serviceSchema = services.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: s.title,
  provider: { '@id': 'https://signaladvise.com/#org' },
  areaServed: { '@type': 'Country', name: 'United States' },
  description: s.body,
}));

const jsonLd = [faqSchema, ...serviceSchema];
---

<Base
  title="Signal Advisory LLC — Independent Telecom & Technology Cost Advisor, Kansas City"
  description="Signal Advisory helps businesses pay less for the technology they already buy. We review your internet, phone, cloud, mobile, and carrier contracts and renegotiate the ones that need it."
  jsonLd={jsonLd}
>
  <Nav />

  <!-- Hero -->
  <section class="container mx-auto max-w-4xl px-6 pb-12 pt-24 md:px-10 md:pt-32 md:pb-20">
    <h1 class="display text-3xl font-light leading-[1.15] md:text-5xl lg:text-[3.5rem]">
      Signal Advisory helps businesses pay less for the
      <em class="text-signal not-italic font-medium">technology they already buy.</em>
    </h1>
    <p class="mt-10 max-w-2xl text-lg leading-relaxed text-ink/80">
      We review your internet, phone, cloud, mobile, and carrier contracts. We renegotiate
      the ones that need it. We stay involved through implementation, billing disputes,
      and the next renewal.
    </p>
    <div class="mt-10">
      <a
        href="/audit"
        class="inline-block rounded-sm bg-signal px-8 py-4 text-sm font-semibold text-paper hover:bg-ink transition-colors"
      >
        Send us one invoice →
      </a>
    </div>
    <p class="mt-10 text-sm text-stone leading-relaxed max-w-2xl">
      25+ years inside major U.S. technology providers. Independent across every major carrier.
      Based in Kansas City, serving clients across the United States.
    </p>
  </section>

  <!-- What we help with -->
  <section class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">What we help with</p>
      <h2 class="display mb-16 max-w-3xl text-3xl font-normal leading-tight md:text-4xl">
        Five categories of decisions.
      </h2>
      <div class="grid gap-x-12 gap-y-10 md:grid-cols-2">
        {helpWith.map((h) => (
          <div class="border-t border-ink/10 pt-6">
            <h3 class="display mb-3 text-xl font-medium">{h.title}</h3>
            <p class="text-ink/70 leading-relaxed text-[15px]">{h.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">How it works</p>
      <h2 class="display mb-16 max-w-3xl text-3xl font-normal leading-tight md:text-4xl">
        Three steps. No commitment until you say so.
      </h2>
      <div class="grid gap-10 md:grid-cols-3">
        {steps.map((s) => (
          <div>
            <p class="mb-3 font-mono text-xs text-stone">{s.n}</p>
            <p class="display text-xl font-medium leading-snug">{s.t}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">Proof</p>
      <h2 class="display mb-16 max-w-3xl text-3xl font-normal leading-tight md:text-4xl">
        Numbers you can defend in a budget meeting.
      </h2>
      <div class="grid gap-8 md:grid-cols-3">
        {proof.map((p) => (
          <div class="border-t border-ink/10 pt-8">
            <p class="display text-5xl font-medium text-signal mb-3">{p.metric}</p>
            <p class="text-ink/70 text-sm leading-relaxed">{p.label}</p>
          </div>
        ))}
      </div>
      <p class="mt-12 text-sm text-stone italic">
        Engagement profiles representative of mid-market work. References available on request.
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section id="contact" class="border-t border-ink/10 bg-ink py-24 text-paper">
    <div class="container mx-auto max-w-3xl px-6 text-center md:px-10">
      <h2 class="display mb-6 text-3xl font-normal leading-tight md:text-4xl">
        Send one invoice.<br />
        <em class="text-signal not-italic font-medium">Know where you stand.</em>
      </h2>
      <p class="mb-10 text-base text-paper/70 leading-relaxed">
        Before you sign another carrier renewal, let us look at the invoice. Twenty-four-hour
        turnaround. No obligation.
      </p>
      <a
        href="/audit"
        class="inline-block rounded-sm bg-signal px-8 py-4 text-sm font-semibold text-paper hover:bg-paper hover:text-ink transition-colors"
      >
        Send us one invoice →
      </a>
      <p class="mt-6 text-sm text-paper/60">
        Or email <a href="mailto:info@signaladvise.com" class="underline text-paper/80">info@signaladvise.com</a> · 816.355.3350
      </p>
    </div>
  </section>

  <Footer />
</Base>
