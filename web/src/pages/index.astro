---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const bills = [
  {
    title: 'Internet and phone lines',
    body: 'Your office internet, your phone system, and the old lines nobody remembers signing up for: alarm, fax, elevator. We check every line item against what you actually use and what the market charges today.',
  },
  {
    title: 'Cell phones and tablets',
    body: 'The wireless bill for your crew, your trucks, and your office. Dead lines, overage charges, and plans that never got updated. This is where most small businesses leak the most money.',
  },
  {
    title: 'Renewals and contracts',
    body: 'Carriers auto-renew you at a higher rate and count on you not noticing. We track your renewal dates and negotiate before they hit, so you never sign another bad deal by accident.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Send one bill. It takes two minutes.',
    body: 'Any recent internet, phone, or wireless invoice. We email you a secure upload link so nothing travels as an attachment.',
  },
  {
    n: '2',
    title: 'Get it back marked up within 24 hours.',
    body: 'We flag what is junk, what is overpriced, and exactly what we would negotiate. If the bill is clean, we tell you that too.',
  },
  {
    n: '3',
    title: 'You decide.',
    body: 'Fix it yourself with our markup, or let us negotiate it with the carrier. You keep your providers. If we do not save you money, you pay nothing.',
  },
];

const serviceSchema = [
  'Business internet and phone bill review',
  'Business wireless and cell phone bill review',
  'Carrier contract renewal negotiation',
].map((name) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: name,
  provider: { '@id': 'https://signaladvise.com/#org' },
  areaServed: { '@type': 'Country', name: 'United States' },
}));

const jsonLd = serviceSchema;
---

<Base
  title="Lower Your Business Internet, Phone and Cell Bills | Signal Advisory, Kansas City"
  description="Signal Advisory lowers what businesses pay for internet, phone, and cell service. Signal Advisory brings 25+ years of experience from inside the major carriers. Free 24-hour bill review. No savings, no fee."
  jsonLd={jsonLd}
>
  <Nav />

  <!-- Hero -->
  <section class="container mx-auto max-w-4xl px-6 pb-12 pt-20 md:px-10 md:pt-28 md:pb-16">
    <p class="mb-5 text-xs uppercase tracking-[0.2em] text-stone">Kansas City · Internet, phone and cell bills for small business</p>
    <h1 class="display text-3xl font-light leading-[1.15] md:text-5xl lg:text-[3.4rem]">
      We lower what your business pays for internet, phone, and cell service.
      <em class="text-signal not-italic font-medium">You keep your providers.</em>
    </h1>
    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink/80">
      Send us one bill. We spent 25+ years inside the major carriers and know
      exactly where they overcharge businesses. We find it and negotiate it down.
      If we do not save you money, you pay nothing.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/audit"
        class="inline-block rounded-sm bg-signal px-8 py-4 text-sm font-semibold text-paper hover:bg-ink transition-colors"
      >
        Get your free bill review →
      </a>
      <a
        href="#how-it-works"
        class="inline-block rounded-sm border border-ink/20 px-8 py-4 text-sm font-medium hover:border-ink transition-colors"
      >
        See how it works
      </a>
    </div>
    <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-2 text-sm text-stone">
      <li>Based in Kansas City</li>
      <li>25+ years inside the carriers</li>
      <li>We work for you, not the phone company</li>
      <li>No savings, no fee</li>
    </ul>
  </section>

  <!-- Proof: figures from /results, confirmed by the owner as real engagements. -->
  <section class="border-t border-ink/10 py-14">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-8 text-xs uppercase tracking-[0.2em] text-stone">Recent results</p>
      <div class="grid gap-8 md:grid-cols-3">
        <div>
          <p class="display text-4xl font-medium text-signal">$94,000</p>
          <p class="mt-2 text-sm text-ink/70">first-year savings for a ten-location manufacturer, with full redundancy kept</p>
        </div>
        <div>
          <p class="display text-4xl font-medium text-signal">6 to 1</p>
          <p class="mt-2 text-sm text-ink/70">providers consolidated for a multi-site retailer: one bill, one point of accountability</p>
        </div>
        <div>
          <p class="display text-4xl font-medium text-signal">23%</p>
          <p class="mt-2 text-sm text-ink/70">lower monthly telecom spend for a single-location business, same carrier, same service</p>
        </div>
      </div>
      <a href="/results" class="mt-8 inline-block text-sm font-medium text-signal hover:underline">See how we did it →</a>
    </div>
  </section>

  <!-- What we do -->
  <section id="what-we-do" class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">What we actually do</p>
      <h2 class="display mb-6 max-w-3xl text-3xl font-normal leading-tight md:text-4xl">
        Three bills. One job: make them smaller.
      </h2>
      <p class="mb-14 max-w-2xl text-ink/75 leading-relaxed">
        If your business pays a carrier for it, we can review it. These are the three places
        almost every small business is overpaying without knowing it.
      </p>
      <div class="grid gap-6 md:grid-cols-3">
        {bills.map((b) => (
          <div class="flex flex-col border border-ink/10 p-8">
            <h3 class="display text-xl font-medium mb-4">{b.title}</h3>
            <p class="text-ink/70 leading-relaxed text-[15px]">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">How it works</p>
      <h2 class="display mb-16 max-w-3xl text-3xl font-normal leading-tight md:text-4xl">
        Three steps. Nothing to install, nothing to switch.
      </h2>
      <div class="grid gap-10 md:grid-cols-3">
        {steps.map((s) => (
          <div>
            <p class="mb-3 font-mono text-xs text-stone">Step {s.n}</p>
            <p class="display text-xl font-medium leading-snug mb-3">{s.title}</p>
            <p class="text-ink/70 leading-relaxed text-[15px]">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Signal Advisory -->
  <section id="why" class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10 grid gap-12 md:grid-cols-5">
      <div class="md:col-span-3">
        <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">Why it works</p>
        <h2 class="display mb-6 text-3xl font-normal leading-tight md:text-4xl">
          25 years on the other side of the table.
        </h2>
        <p class="text-ink/75 leading-relaxed mb-5">
          Signal Advisory brings more than 25 years of experience from inside the major U.S.
          carriers, pricing and structuring the very contracts businesses sign. We know which
          fees are negotiable, which "taxes" are not actually taxes, and what a carrier will
          really concede when someone who knows the playbook asks.
        </p>
        <p class="text-ink/75 leading-relaxed">
          Signal Advisory is independent. We are not tied to any provider, we do not sell
          carriers, and we do not get paid by you unless your bill goes down.
        </p>
        <a href="/results" class="mt-8 inline-block text-sm font-medium text-signal hover:underline">
          See what the work looks like →
        </a>
      </div>
      <div class="md:col-span-2 border border-ink/10 p-8">
        <p class="display text-xl font-medium mb-2">Signal Advisory</p>
        <p class="text-sm text-stone mb-6">Independent telecom advisory · Kansas City, MO</p>
        <p class="text-sm text-ink/80 leading-relaxed mb-6">
          A dedicated advisor on every account. Not a franchise, not a call center, not a carrier sales team.
        </p>
        <p class="text-sm">
          <a href="tel:+18163553350" class="font-medium hover:text-signal">816-355-3350</a><br />
          <a href="mailto:info@signaladvise.com" class="font-medium hover:text-signal">info@signaladvise.com</a>
        </p>
      </div>
    </div>
  </section>



  <!-- Final CTA -->
  <section id="contact" class="border-t border-ink/10 bg-ink py-24 text-paper">
    <div class="container mx-auto max-w-3xl px-6 text-center md:px-10">
      <h2 class="display mb-6 text-3xl font-normal leading-tight md:text-4xl">
        Send one bill.<br />
        <em class="text-signal not-italic font-medium">Know where you stand in 24 hours.</em>
      </h2>
      <p class="mb-10 text-base text-paper/70 leading-relaxed">
        Free review. No obligation. If we do not save you money, you pay nothing.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/audit"
          class="inline-block rounded-sm bg-signal px-8 py-4 text-sm font-semibold text-paper hover:bg-paper hover:text-ink transition-colors"
        >
          Get your free bill review →
        </a>
        <a
          href="https://calendly.com/signaladvise-info/30min"
          target="_blank"
          rel="noopener"
          class="inline-block rounded-sm border border-paper/30 px-8 py-4 text-sm font-semibold text-paper hover:bg-paper hover:text-ink transition-colors"
        >
          Book a 15-minute call
        </a>
      </div>
      <p class="mt-6 text-sm text-paper/60">
        Or call <a href="tel:+18163553350" class="underline text-paper/80">816-355-3350</a> · <a href="mailto:info@signaladvise.com" class="underline text-paper/80">info@signaladvise.com</a>
      </p>
    </div>
  </section>

  <Footer />
</Base>
