---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    tag: '01',
    title: 'Provider negotiation',
    body: 'We renegotiate your internet, phone, and cloud contracts directly with the providers. Every major carrier in the U.S. — AT&T, Verizon, Lumen, Spectrum, Comcast Business, and 200+ others — quoted on your behalf. Because we work for you, not the providers, our recommendation is the best fit for your business, not the highest commission.',
  },
  {
    tag: '02',
    title: 'Vendor consolidation',
    body: 'Most companies pay 4 to 6 different providers for technology services that should come from one or two. We map your current vendors, find the overlap, and consolidate down without losing the redundancy you actually need.',
  },
  {
    tag: '03',
    title: 'Telecom expense management',
    body: 'Every month, we audit your telecom invoices for billing errors, unused services, and contract violations. The typical mid-market company is overpaying 3 to 6 percent through mistakes the providers will not catch on their own. We catch them, dispute them, and recover the money.',
  },
  {
    tag: '04',
    title: 'Ongoing advisory',
    body: 'Long-term independent guidance on which providers to use, when to renew, and how to structure contracts. Hourly or monthly retainer. No commissions tied to any single recommendation, so the advice you receive is the advice we would follow ourselves.',
  },
];

const differentiators = [
  {
    title: 'We work for you',
    body: 'You pay us. The providers do not. That single fact changes what we are willing to tell you compared to a typical sales agent.',
  },
  {
    title: 'We stay accountable',
    body: 'After the contract is signed, we stay on the account. Implementation, billing questions, service problems, renewals — we are still on your team. Most agents disappear once the deal closes.',
  },
  {
    title: 'We know the inside game',
    body: 'Our principals spent decades inside the largest providers in the country. We know how they price, where the margin hides, and which terms they will move on when pushed.',
  },
];
---

<Base>
  <Nav />

  <!-- Hero -->
  <section class="container mx-auto max-w-5xl px-6 pb-28 pt-20 md:px-10 md:pt-28">
    <p class="mb-5 text-xs uppercase tracking-[0.2em] text-stone">
      Independent technology advisors
    </p>
    <h1 class="display text-5xl font-light leading-[1.0] md:text-[5rem]">
      Lower the cost of the technology<br />
      <em class="text-signal not-italic font-medium">you already pay for.</em>
    </h1>
    <p class="mt-10 max-w-2xl text-lg leading-relaxed text-ink/80">
      We help mid-market companies negotiate better deals on the internet, phone systems,
      cloud services, and software they are already buying. We work for you. The providers
      do not pay us, so we are free to tell you the truth about who is overcharging and where
      the leverage actually is.
    </p>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink/70">
      The typical mid-market client sees <strong class="text-ink">$40,000 to $120,000</strong>
      in first-year savings on technology spend they were already paying. If we cannot find
      cost reduction in an initial review, we pay you for the hour you spent with us.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="https://calendly.com/signaladvise-info/30min"
        target="_blank"
        rel="noopener"
        class="inline-block rounded-sm bg-signal px-6 py-3 text-sm font-semibold text-paper hover:bg-ink transition-colors"
      >
        Schedule a consultation
      </a>
      <a
        href="/audit"
        class="inline-block rounded-sm border border-ink/20 px-6 py-3 text-sm font-medium hover:border-ink transition-colors"
      >
        Free invoice audit →
      </a>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">What we do</p>
      <h2 class="display mb-6 max-w-3xl text-4xl font-normal leading-tight md:text-5xl">
        Four ways we lower your technology costs.
      </h2>
      <p class="mb-16 max-w-2xl text-ink/70 leading-relaxed">
        Engage us for one of these or all four. Most clients start with a single contract
        review and add the rest as we earn the relationship.
      </p>
      <div class="grid gap-x-10 gap-y-14 md:grid-cols-2">
        {
          services.map((s) => (
            <div class="border-t border-ink/10 pt-8">
              <p class="mb-3 font-mono text-xs text-stone">{s.tag}</p>
              <h3 class="display mb-4 text-2xl font-medium">{s.title}</h3>
              <p class="text-ink/70 leading-relaxed text-[15px]">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why Signal -->
  <section class="border-t border-ink/10 bg-ink py-24 text-paper">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-paper/40">Why Signal Advisory</p>
      <h2 class="display mb-4 max-w-3xl text-4xl font-normal leading-tight md:text-5xl">
        Honest advice. From someone who is not selling it.
      </h2>
      <p class="mb-16 max-w-2xl text-paper/60 text-lg leading-relaxed">
        Most technology agents are paid by the providers they recommend. We are not. You write
        us a check; the providers do not. That structural difference is the entire reason the
        advice we give is different from the advice you have received before.
      </p>
      <div class="grid gap-10 md:grid-cols-3">
        {
          differentiators.map((d) => (
            <div class="border-t border-paper/10 pt-8">
              <h3 class="display mb-4 text-xl font-medium">{d.title}</h3>
              <p class="text-paper/60 leading-relaxed text-[15px]">{d.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Recent outcomes / proof -->
  <section class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">What the work looks like</p>
      <h2 class="display mb-16 max-w-3xl text-4xl font-normal leading-tight md:text-5xl">
        Real outcomes. Numbers you can defend in a budget meeting.
      </h2>
      <div class="grid gap-8 md:grid-cols-3">
        {[
          {
            metric: '$94k',
            label: 'Annual savings, year one',
            note: 'Mid-market manufacturer · MPLS to SD-WAN transition, dual-carrier diversity preserved at lower spend.',
          },
          {
            metric: '6 → 1',
            label: 'Vendor relationships consolidated',
            note: 'Multi-site retail client · Five carrier invoices and one UCaaS contract reduced to a single quarterly statement and one point of accountability.',
          },
          {
            metric: '23%',
            label: 'Telecom spend reduction',
            note: 'Logistics company · Renegotiated three-year renewal with incumbent carrier ahead of cycle; preserved flexibility, reduced effective rate.',
          },
        ].map((c) => (
          <div class="border border-ink/10 p-8">
            <p class="display text-5xl font-medium text-signal mb-3">{c.metric}</p>
            <p class="text-ink mb-3 font-medium">{c.label}</p>
            <p class="text-ink/60 text-sm leading-relaxed">{c.note}</p>
          </div>
        ))}
      </div>
      <p class="mt-12 text-sm text-stone italic">
        Engagement profiles representative of typical mid-market client work. Contact us for client references on request.
      </p>
    </div>
  </section>

  <!-- Approach -->
  <section id="about" class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <div class="grid gap-16 md:grid-cols-2 md:items-center">
        <div>
          <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">How we work</p>
          <h2 class="display mb-6 text-4xl font-normal leading-tight md:text-5xl">
            On your side of the table.
          </h2>
          <p class="text-ink/75 leading-relaxed mb-6">
            We were built on a simple idea: the people who buy technology deserve the same
            quality of advice the providers themselves receive when they negotiate. Today, most
            companies do not get that.
          </p>
          <p class="text-ink/75 leading-relaxed">
            Our principals spent more than two decades inside the largest technology providers
            in the country. We know how they price their services, where the margin actually
            sits, and which terms they will move on when pressed. We use that knowledge on
            behalf of clients — from a ten-person company buying their first business phone
            system to a multi-site company renegotiating a seven-figure contract.
          </p>
        </div>
        <div class="grid gap-6">
          {[
            { num: '25+', label: 'Years of combined experience inside the largest technology providers' },
            { num: '150+', label: 'Providers we can quote on your behalf, across every category' },
            { num: '2', label: 'Master agent partnerships (Avant, AppDirect) giving us direct contract access' },
          ].map((stat) => (
            <div class="border border-ink/10 p-8">
              <p class="display text-5xl font-medium text-signal mb-2">{stat.num}</p>
              <p class="text-ink/60 text-sm leading-relaxed">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="border-t border-ink/10 bg-ink py-24 text-paper">
    <div class="container mx-auto max-w-3xl px-6 text-center md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-paper/40">Get started</p>
      <h2 class="display mb-6 text-4xl font-normal leading-tight md:text-5xl">
        Send us your last invoice.
      </h2>
      <p class="mb-10 text-lg text-paper/60 leading-relaxed">
        We will mark up where we would renegotiate, what we would target, and whether the
        savings are worth the conversation. No obligation, twenty-four hour turnaround. If we
        cannot find savings, the time we spent is on us.
      </p>
      <a
        href="/audit"
        class="inline-block rounded-sm bg-signal px-8 py-4 text-sm font-semibold text-paper hover:bg-paper hover:text-ink transition-colors"
      >
        Request a free invoice review
      </a>
      <p class="mt-6 text-sm text-paper/50">
        Or email <a href="mailto:info@signaladvise.com" class="text-paper/70 underline">info@signaladvise.com</a> directly.
      </p>
    </div>
  </section>

  <Footer />
</Base>
