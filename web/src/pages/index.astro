---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    tag: '01',
    title: 'Provider negotiation',
    body: 'We negotiate directly with every major U.S. provider on your behalf. Rate is one variable. Term length, exit rights, and rate-protection clauses move more money over the life of a contract, and most agents will not press for them.',
  },
  {
    tag: '02',
    title: 'Vendor consolidation',
    body: 'Mid-market companies typically pay four to six providers for services that should sit with one or two. We start with a single-page inventory of every contract, renewal date, and monthly cost. From there the consolidation decisions get straightforward.',
  },
  {
    tag: '03',
    title: 'Telecom expense management',
    body: 'Every invoice, audited against every contract, every month. Errors are disputed. Unused services are retired. Credits land on the next bill. On a typical mid-market footprint this work recovers three to six percent of annual telecom spend.',
  },
  {
    tag: '04',
    title: 'Ongoing advisory',
    body: 'Hourly or monthly retainer covering the technology decisions your team makes between major engagements — renewals, architecture, vendor selection, contract structure. On call when the question comes up.',
  },
];

const differentiators = [
  {
    title: 'Aligned',
    body: 'Clients pay us. Providers do not. The recommendation is the same one we would give if it were our own contract.',
  },
  {
    title: 'Accountable',
    body: 'We stay on every account through implementation, billing disputes, and the next renewal. Most agents do not.',
  },
  {
    title: 'Experienced',
    body: 'Our principals worked inside the largest U.S. technology providers for decades. We know where margin sits and which terms they will move on.',
  },
];

const capabilities = [
  {
    group: 'Network & Connectivity',
    items: ['Internet (DIA, broadband, fiber)', 'Network design (SD-WAN, MPLS, SASE)', 'Data center connectivity', 'Cloud on-ramp'],
  },
  {
    group: 'Voice & Communications',
    items: ['Cloud phone systems (UCaaS)', 'Contact center', 'Voice services (SIP, PRI)', 'Conference-room A/V'],
  },
  {
    group: 'Cloud & Infrastructure',
    items: ['Public, private, and hybrid cloud', 'IaaS, PaaS, SaaS sourcing', 'Hardware procurement', 'Software licensing'],
  },
  {
    group: 'Security & Operations',
    items: ['Network and endpoint security', 'Mobility and MDM', 'IoT and connected devices', 'Energy procurement'],
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does a technology broker do?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'An independent technology broker represents the buyer, not the carrier. We inventory every technology contract a business has — internet, phone, mobile, cloud, security — then put providers in competition for the renewal. The result is lower cost, better terms, and fewer vendors to manage. The client pays the broker; the providers do not.',
      },
    },
    {
      '@type': 'Question',
      name: 'How much can a business save by auditing telecom and technology invoices?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A typical mid-market audit recovers three to six percent of annual telecom and technology spend through billing errors, unused services, and renegotiation. Small businesses commonly save 15 to 30 percent on a single internet or phone contract when it is put out to bid.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I have to switch carriers to work with Signal Advisory?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Many of our engagements end with the client staying on the incumbent carrier at materially better rates and terms. The leverage is in being willing to switch, not in actually switching.',
      },
    },
    {
      '@type': 'Question',
      name: 'How are independent technology brokers paid?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Signal Advisory is paid directly by the client, typically on contingency against documented savings or on a monthly advisory retainer. We do not accept commissions from carriers, which is what separates an independent broker from a master agent.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the difference between a technology broker and a master agent?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A master agent is paid by the carrier and is required to disclose that relationship. Their economic incentive is to place you with the carrier that pays them most. An independent technology broker is paid by you, has no carrier in the recommendation, and audits the contract on your behalf after it is signed.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where is Signal Advisory based?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Signal Advisory is based in Kansas City, Missouri, and serves clients across the United States. Reach Brandon Murphy at 816-355-3350 or brandon@signaladvise.com.',
      },
    },
  ],
};

const serviceSchema = services.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: s.title,
  provider: { '@id': 'https://signaladvise.com/#org' },
  areaServed: { '@type': 'Country', name: 'United States' },
  description: s.body,
}));

const jsonLd = [faqSchema, ...serviceSchema];
---

<Base jsonLd={jsonLd}>
  <Nav />

  <!-- Hero -->
  <section class="container mx-auto max-w-5xl px-6 pb-28 pt-20 md:px-10 md:pt-28">
    <p class="mb-5 text-xs uppercase tracking-[0.2em] text-stone">
      Independent technology advisors
    </p>
    <h1 class="display text-5xl font-light leading-[1.0] md:text-[5rem]">
      Buy technology<br />
      <em class="text-signal not-italic font-medium">better.</em>
    </h1>
    <p class="mt-10 max-w-2xl text-lg leading-relaxed text-ink/80">
      We work with mid-market leadership teams to lower the cost of the network, voice,
      cloud, and software services that run their business. We negotiate the contracts. We
      audit the invoices. We stay involved through every renewal. Clients pay us directly.
      Providers do not.
    </p>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink/70">
      First-year savings typically run <strong class="text-ink">$40,000 to $120,000</strong>
      on a mid-market footprint. If an initial review does not surface savings, the time is
      on us.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="https://calendly.com/signaladvise-info/30min"
        target="_blank"
        rel="noopener"
        class="inline-block rounded-sm bg-signal px-6 py-3 text-sm font-semibold text-paper hover:bg-ink transition-colors"
      >
        Schedule a consultation
      </a>
      <a
        href="/audit"
        class="inline-block rounded-sm border border-ink/20 px-6 py-3 text-sm font-medium hover:border-ink transition-colors"
      >
        Free invoice audit →
      </a>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">What we do</p>
      <h2 class="display mb-6 max-w-3xl text-4xl font-normal leading-tight md:text-5xl">
        Four ways we lower your technology costs.
      </h2>
      <p class="mb-16 max-w-2xl text-ink/70 leading-relaxed">
        Engage us for one of these or for all four. Most clients begin with a contract
        review and add the rest over time.
      </p>
      <div class="grid gap-x-10 gap-y-14 md:grid-cols-2">
        {
          services.map((s) => (
            <div class="border-t border-ink/10 pt-8">
              <p class="mb-3 font-mono text-xs text-stone">{s.tag}</p>
              <h3 class="display mb-4 text-2xl font-medium">{s.title}</h3>
              <p class="text-ink/70 leading-relaxed text-[15px]">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">Capabilities</p>
      <h2 class="display mb-6 max-w-3xl text-4xl font-normal leading-tight md:text-5xl">
        Every category of business technology.
      </h2>
      <p class="mb-16 max-w-2xl text-ink/70 leading-relaxed">
        We work across the full range of services a company pays for every month. If it
        carries a monthly invoice, we can probably help you buy it for less.
      </p>
      <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
        {
          capabilities.map((c) => (
            <div>
              <h3 class="display text-lg font-medium text-ink mb-4">{c.group}</h3>
              <ul class="space-y-2 text-sm text-ink/70">
                {c.items.map((item) => (
                  <li class="leading-relaxed">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why Signal -->
  <section class="border-t border-ink/10 bg-ink py-24 text-paper">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-paper/40">Why Signal Advisory</p>
      <h2 class="display mb-4 max-w-3xl text-4xl font-normal leading-tight md:text-5xl">
        The buyer needs a partner. The seller already has one.
      </h2>
      <p class="mb-16 max-w-2xl text-paper/60 text-lg leading-relaxed">
        Most technology agents earn commissions from the providers they recommend. We work
        the other way. Clients pay us directly. The model determines the work — what we say,
        what we negotiate, and what we walk away from.
      </p>
      <div class="grid gap-10 md:grid-cols-3">
        {
          differentiators.map((d) => (
            <div class="border-t border-paper/10 pt-8">
              <h3 class="display mb-4 text-xl font-medium">{d.title}</h3>
              <p class="text-paper/60 leading-relaxed text-[15px]">{d.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Recent outcomes / proof -->
  <section class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">What the work looks like</p>
      <h2 class="display mb-16 max-w-3xl text-4xl font-normal leading-tight md:text-5xl">
        Real outcomes. Numbers you can defend in a budget meeting.
      </h2>
      <div class="grid gap-8 md:grid-cols-3">
        {[
          {
            metric: '$94k',
            label: 'Annual savings, year one',
            note: 'Mid-market manufacturer · MPLS to SD-WAN transition, dual-carrier diversity preserved at lower spend.',
          },
          {
            metric: '6 → 1',
            label: 'Vendor relationships consolidated',
            note: 'Multi-site retail client · Five carrier invoices and one UCaaS contract reduced to a single quarterly statement and one point of accountability.',
          },
          {
            metric: '23%',
            label: 'Telecom spend reduction',
            note: 'Logistics company · Renegotiated three-year renewal with incumbent carrier ahead of cycle; preserved flexibility, reduced effective rate.',
          },
        ].map((c) => (
          <div class="border border-ink/10 p-8">
            <p class="display text-5xl font-medium text-signal mb-3">{c.metric}</p>
            <p class="text-ink mb-3 font-medium">{c.label}</p>
            <p class="text-ink/60 text-sm leading-relaxed">{c.note}</p>
          </div>
        ))}
      </div>
      <p class="mt-12 text-sm text-stone italic">
        Engagement profiles representative of typical mid-market client work. Contact us for client references on request.
      </p>
    </div>
  </section>

  <!-- Approach -->
  <section id="about" class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <div class="grid gap-16 md:grid-cols-2 md:items-center">
        <div>
          <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">How we work</p>
          <h2 class="display mb-6 text-4xl font-normal leading-tight md:text-5xl">
            On the buyer's side.
          </h2>
          <p class="text-ink/75 leading-relaxed mb-6">
            The companies that buy technology should have the same quality of counsel the
            companies that sell it already do. Most do not. We close that gap.
          </p>
          <p class="text-ink/75 leading-relaxed">
            Our principals worked inside the largest U.S. technology providers for more than
            two decades. We know how they build their pricing, where the margin sits, and
            which terms they will move on when pressed. We apply that knowledge to client
            contracts — from a ten-person business buying its first phone system to a
            multi-site company renegotiating a seven-figure agreement.
          </p>
        </div>
        <div class="grid gap-6">
          {[
            { num: '25+', label: 'Years inside the largest U.S. technology providers' },
            { num: '200+', label: 'Providers quoted across every business technology category' },
            { num: '$40k–$120k', label: 'Typical first-year savings on a mid-market footprint' },
          ].map((stat) => (
            <div class="border border-ink/10 p-8">
              <p class="display text-4xl md:text-5xl font-medium text-signal mb-2">{stat.num}</p>
              <p class="text-ink/60 text-sm leading-relaxed">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="border-t border-ink/10 bg-ink py-24 text-paper">
    <div class="container mx-auto max-w-3xl px-6 text-center md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-paper/40">Get started</p>
      <h2 class="display mb-6 text-4xl font-normal leading-tight md:text-5xl">
        Start with one invoice.
      </h2>
      <p class="mb-10 text-lg text-paper/60 leading-relaxed">
        Send a recent telecom or cloud invoice. We mark up what we would renegotiate, what we
        would target, and what the savings are likely worth. Twenty-four hour turnaround.
        No obligation. If there is nothing material to recover, the review is free.
      </p>
      <a
        href="/audit"
        class="inline-block rounded-sm bg-signal px-8 py-4 text-sm font-semibold text-paper hover:bg-paper hover:text-ink transition-colors"
      >
        Request a free invoice review
      </a>
      <p class="mt-6 text-sm text-paper/50">
        Or email <a href="mailto:info@signaladvise.com" class="text-paper/70 underline">info@signaladvise.com</a> directly.
      </p>
    </div>
  </section>

  <Footer />
</Base>
