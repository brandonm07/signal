---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    tag: '01',
    title: 'Provider negotiation',
    body: 'We negotiate directly with every major U.S. provider on your behalf. Rate is one variable. Term length, exit rights, redundancy, and rate-protection clauses move more money over the life of a contract — and most agents will not press for them.',
  },
  {
    tag: '02',
    title: 'Vendor consolidation',
    body: 'Mid-market companies typically pay four to six providers for services that should sit with one or two. We start with a single-page inventory of every contract, renewal date, and monthly cost. From there the consolidation decisions get straightforward.',
  },
  {
    tag: '03',
    title: 'Telecom expense management',
    body: 'Every invoice, audited against every contract, every month. Errors are disputed. Unused services are retired. Credits land on the next bill. On a typical mid-market footprint this work recovers three to six percent of annual telecom spend.',
  },
  {
    tag: '04',
    title: 'Ongoing advisory',
    body: 'Hourly or monthly retainer covering the technology decisions your team makes between major engagements — renewals, architecture, vendor selection, contract structure. On call when the question comes up.',
  },
];

const cases = [
  {
    metric: '$94k',
    label: 'Annual savings, year one',
    before: 'A ten-location manufacturer had MPLS, backup internet, and voice split across multiple vendors. Renewal dates were scattered. No one had a clean inventory.',
    did: 'Built a site-by-site inventory, priced SD-WAN alternatives, preserved carrier diversity, and renegotiated renewal terms ahead of cycle.',
    result: '$94,000 first-year savings while preserving redundancy.',
  },
  {
    metric: '6 → 1',
    label: 'Vendor relationships consolidated',
    before: 'A multi-site retail client was managing five carrier invoices and a separate UCaaS contract. Renewals were rolling, support escalations went nowhere, and no single vendor owned the relationship.',
    did: 'Consolidated connectivity and voice onto one provider with a single quarterly statement. Renegotiated SLA and credit terms in the process.',
    result: 'One bill. One point of accountability. Lower effective rate.',
  },
  {
    metric: '23%',
    label: 'Telecom spend reduction',
    before: 'A logistics company was twelve months from renewal on a three-year carrier contract. The incumbent had quietly raised rates twice and removed line items the company still believed were active.',
    did: 'Audited the invoice against the original contract, recovered credits for retired services, and renegotiated the next term six months early using competitive pressure.',
    result: '23% reduction in monthly telecom spend, same carrier, same circuits.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does an independent technology broker do?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'An independent technology broker represents the buyer in technology purchasing decisions. We inventory every contract a business has — internet, phone, mobile, cloud, security — then put providers in competition for the renewal. The result is lower cost, better contract terms, and fewer vendors to manage. We are independent across every major U.S. provider rather than tied to any one of them.',
      },
    },
    {
      '@type': 'Question',
      name: 'How much can a business save by auditing telecom and technology invoices?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A typical mid-market audit recovers three to six percent of annual telecom and technology spend through billing errors, unused services, and renegotiation. Small businesses commonly save 15 to 30 percent on a single internet or phone contract when it is put out to bid.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I have to switch carriers to work with Signal Advisory?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Many of our engagements end with the client staying on the incumbent carrier at materially better rates and terms. The leverage is in being willing to switch, not in actually switching.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does Signal Advisory get paid?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Engagements run on three models: a flat-fee contract review, hourly project work, or a monthly retainer for ongoing advisory. On brokered transactions we are compensated by the carrier through our master agency relationships, which is the standard model in the channel. For clients who prefer a fee-only arrangement, we can rebate the brokerage commission against a flat advisory fee.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is Signal Advisory different from a master agent?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We work independently across every major U.S. provider rather than steering business to any one carrier. We stay involved through implementation, billing disputes, and the next renewal — most agents disappear after signature. We negotiate the contract terms that protect the buyer, not just the rate that closes the deal.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where is Signal Advisory based?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Signal Advisory is based in Kansas City, Missouri, and serves clients across the United States. Reach Brandon Murphy at 816-355-3350 or brandon@signaladvise.com.',
      },
    },
  ],
};

const serviceSchema = services.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: s.title,
  provider: { '@id': 'https://signaladvise.com/#org' },
  areaServed: { '@type': 'Country', name: 'United States' },
  description: s.body,
}));

const jsonLd = [faqSchema, ...serviceSchema];
---

<Base
  title="Signal Advisory LLC — Independent Telecom & Technology Cost Advisor, Kansas City"
  description="Stop overpaying for internet, voice, mobile, cloud, and carrier contracts. Signal Advisory audits invoices, renegotiates renewals, and consolidates vendors for businesses across the United States."
  jsonLd={jsonLd}
>
  <Nav />

  <!-- Hero -->
  <section class="container mx-auto max-w-5xl px-6 pb-20 pt-20 md:px-10 md:pt-28">
    <p class="mb-5 text-xs uppercase tracking-[0.2em] text-stone">
      Independent telecom &amp; technology cost advisor · Kansas City
    </p>
    <h1 class="display text-4xl font-light leading-[1.05] md:text-[4.5rem]">
      Stop overpaying for<br />
      <em class="text-signal not-italic font-medium">business technology.</em>
    </h1>
    <p class="mt-10 max-w-2xl text-lg leading-relaxed text-ink/80">
      We help growing companies cut internet, voice, mobile, cloud, and carrier contract
      costs — and renegotiate them before the next auto-renewal locks in. Send one recent
      invoice. Within 24 business hours we'll mark up what we'd renegotiate, what fees
      look inflated, and where savings are likely hiding.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/audit"
        class="inline-block rounded-sm bg-signal px-8 py-4 text-sm font-semibold text-paper hover:bg-ink transition-colors"
      >
        Send one invoice →
      </a>
      <a
        href="https://calendly.com/signaladvise-info/30min"
        target="_blank"
        rel="noopener"
        class="inline-block rounded-sm border border-ink/20 px-8 py-4 text-sm font-medium hover:border-ink transition-colors"
      >
        Schedule a 30-min call
      </a>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="border-t border-ink/10 bg-ink py-10 text-paper">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <div class="grid gap-6 md:grid-cols-3">
        <div>
          <p class="display text-2xl font-medium text-signal mb-1">25+ years</p>
          <p class="text-paper/70 text-sm leading-relaxed">Inside major U.S. technology providers</p>
        </div>
        <div>
          <p class="display text-2xl font-medium text-signal mb-1">$40k–$120k</p>
          <p class="text-paper/70 text-sm leading-relaxed">Typical first-year savings on a mid-market footprint</p>
        </div>
        <div>
          <p class="display text-2xl font-medium text-signal mb-1">24 hours</p>
          <p class="text-paper/70 text-sm leading-relaxed">Turnaround on a free invoice review</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Who we help -->
  <section class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">Who we help</p>
      <h2 class="display mb-16 max-w-3xl text-4xl font-normal leading-tight md:text-5xl">
        Two profiles. One review.
      </h2>
      <div class="grid gap-10 md:grid-cols-2">
        <div class="border-t border-ink/10 pt-8">
          <h3 class="display mb-4 text-2xl font-medium">Growing businesses</h3>
          <p class="text-ink/70 leading-relaxed text-[15px] mb-4">
            One to ten locations. No internal telecom expert. Tired of confusing invoices,
            quiet rate increases, and providers who never call back unless you're trying
            to leave.
          </p>
          <p class="text-stone text-sm leading-relaxed">
            Typical monthly spend: $1,500–$15,000 across internet, phone, mobile, and software.
          </p>
        </div>
        <div class="border-t border-ink/10 pt-8">
          <h3 class="display mb-4 text-2xl font-medium">Multi-site companies</h3>
          <p class="text-ink/70 leading-relaxed text-[15px] mb-4">
            Five to twenty-five-plus locations. Renewals coming up. Carrier sprawl across
            sites. SD-WAN, MPLS, or hybrid network decisions on the table. Backup-circuit
            and redundancy questions that have not been answered cleanly.
          </p>
          <p class="text-stone text-sm leading-relaxed">
            Typical engagements: contract review, multi-site inventory, renewal strategy.
          </p>
        </div>
      </div>
      <p class="mt-12 text-sm text-stone">
        Both start the same way: send a recent invoice, get a 24-hour markup.
      </p>
    </div>
  </section>

  <!-- What we find -->
  <section class="border-t border-ink/10 bg-paper py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">What we find</p>
      <h2 class="display mb-16 max-w-3xl text-4xl font-normal leading-tight md:text-5xl">
        The leaks are usually the same.
      </h2>
      <div class="grid gap-x-10 gap-y-6 md:grid-cols-2">
        {[
          'Inflated carrier fees and surcharges',
          'Bad renewal timing — leverage gone before you ask',
          'Unused services still billing every month',
          'Overpriced circuits at one or two specific sites',
          'No backup or weak failover paths',
          'Contract terms that favor the carrier',
          'Vendor sprawl that should consolidate',
          'Auto-renewals that should never have triggered',
        ].map((line) => (
          <p class="border-t border-ink/10 pt-4 text-ink/80 leading-relaxed">{line}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">How it works</p>
      <h2 class="display mb-16 max-w-3xl text-4xl font-normal leading-tight md:text-5xl">
        Three steps. No commitment until you say so.
      </h2>
      <div class="grid gap-10 md:grid-cols-3">
        {[
          { n: '01', t: 'Send one invoice', b: 'Upload a recent carrier, internet, voice, or mobile bill. One file. No form behind a form.' },
          { n: '02', t: 'We mark it up', b: 'Within 24 business hours you receive a marked-up version showing what we would challenge, renegotiate, or retire.' },
          { n: '03', t: 'You decide', b: 'If the math justifies it, we run the engagement. If it does not, we tell you. No pressure call.' },
        ].map((s) => (
          <div>
            <p class="mb-3 font-mono text-xs text-stone">{s.n}</p>
            <h3 class="display mb-4 text-xl font-medium">{s.t}</h3>
            <p class="text-ink/70 leading-relaxed text-[15px]">{s.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services (kept, condensed) -->
  <section id="services" class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">What we do</p>
      <h2 class="display mb-16 max-w-3xl text-4xl font-normal leading-tight md:text-5xl">
        Four ways we lower your technology costs.
      </h2>
      <div class="grid gap-x-10 gap-y-14 md:grid-cols-2">
        {
          services.map((s) => (
            <div class="border-t border-ink/10 pt-8">
              <p class="mb-3 font-mono text-xs text-stone">{s.tag}</p>
              <h3 class="display mb-4 text-2xl font-medium">{s.title}</h3>
              <p class="text-ink/70 leading-relaxed text-[15px]">{s.body}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-14 text-sm text-stone">
        <a href="/services" class="underline">See every category of business technology we work across →</a>
      </p>
    </div>
  </section>

  <!-- Mini case studies -->
  <section class="border-t border-ink/10 bg-paper py-24">
    <div class="container mx-auto max-w-5xl px-6 md:px-10">
      <p class="mb-4 text-xs uppercase tracking-[0.2em] text-stone">What the work looks like</p>
      <h2 class="display mb-16 max-w-3xl text-4xl font-normal leading-tight md:text-5xl">
        Numbers you can defend in a budget meeting.
      </h2>
      <div class="space-y-12">
        {
          cases.map((c) => (
            <div class="border-t border-ink/10 pt-10 grid gap-8 md:grid-cols-[200px_1fr]">
              <div>
                <p class="display text-5xl font-medium text-signal mb-2">{c.metric}</p>
                <p class="text-ink font-medium text-sm">{c.label}</p>
              </div>
              <div class="grid gap-6 md:grid-cols-3 text-sm">
                <div>
                  <p class="mb-2 text-xs uppercase tracking-[0.15em] text-stone">Before</p>
                  <p class="text-ink/75 leading-relaxed">{c.before}</p>
                </div>
                <div>
                  <p class="mb-2 text-xs uppercase tracking-[0.15em] text-stone">What we did</p>
                  <p class="text-ink/75 leading-relaxed">{c.did}</p>
                </div>
                <div>
                  <p class="mb-2 text-xs uppercase tracking-[0.15em] text-stone">Result</p>
                  <p class="text-ink/75 leading-relaxed">{c.result}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
      <p class="mt-12 text-sm text-stone italic">
        Engagement profiles representative of typical mid-market work. References available on request.
      </p>
    </div>
  </section>

  <!-- One-line differentiator -->
  <section class="border-t border-ink/10 bg-ink py-20 text-paper">
    <div class="container mx-auto max-w-3xl px-6 text-center md:px-10">
      <p class="display text-2xl font-normal leading-snug md:text-3xl">
        Independent across every major U.S. provider. On the buyer's side through
        implementation, billing disputes, and the next renewal.
      </p>
      <p class="mt-6 text-paper/60 text-base">Most agents disappear after signature. We don't.</p>
    </div>
  </section>

  <!-- Final CTA -->
  <section id="contact" class="border-t border-ink/10 py-24">
    <div class="container mx-auto max-w-3xl px-6 text-center md:px-10">
      <h2 class="display mb-6 text-4xl font-normal leading-tight md:text-5xl">
        Send one invoice.<br />
        <em class="text-signal not-italic font-medium">Know where you stand.</em>
      </h2>
      <p class="mb-10 text-lg text-ink/70 leading-relaxed">
        Before your next carrier renewal, let us look at the invoice. Twenty-four hour
        turnaround. No obligation. If there is nothing material to recover, the review is free.
      </p>
      <a
        href="/audit"
        class="inline-block rounded-sm bg-signal px-8 py-4 text-sm font-semibold text-paper hover:bg-ink transition-colors"
      >
        Send one invoice →
      </a>
      <p class="mt-6 text-sm text-stone">
        Or email <a href="mailto:info@signaladvise.com" class="underline">info@signaladvise.com</a> · 816.355.3350
      </p>
    </div>
  </section>

  <Footer />
</Base>
