<footer class="border-t border-ink/10 py-12">
  <div class="container mx-auto max-w-5xl px-6 md:px-10">
    <div class="grid gap-10 text-sm md:grid-cols-3">
      <div>
        <p class="display text-lg font-medium mb-2">Signal Advisory</p>
        <p class="text-stone leading-relaxed">
          We lower what businesses pay for internet, phone, and wireless service. We work for you, not the carriers.
        </p>
        <p class="mt-4 text-stone">
          <a href="tel:+18163553350" class="hover:text-ink">816-355-3350</a><br />
          <a href="mailto:info@signaladvise.com" class="hover:text-ink">info@signaladvise.com</a><br />
          Kansas City, Missouri
        </p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.15em] text-stone mb-3">Explore</p>
        <ul class="space-y-2">
          <li><a href="/audit" class="hover:text-signal">Free bill review</a></li>
          <li><a href="/results" class="hover:text-signal">Results</a></li>
          <li><a href="/services" class="hover:text-signal">All services</a></li>
