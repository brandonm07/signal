          <li><a href="/platform" class="hover:text-signal">Client dashboard</a></li>
          <li><a href="https://api.signaladvise.com/portal" class="hover:text-signal">Client sign in</a></li>
          <li><a href="/security" class="hover:text-signal">Security</a></li>
        </ul>
